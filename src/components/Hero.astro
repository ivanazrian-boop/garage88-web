---

---

<section class="bg-gradient-to-r from-slate-900 to-slate-700">

  <div class="mx-auto max-w-7xl px-6 py-24">

    <div class="max-w-3xl">


      <p class="mb-6 text-sm uppercase tracking-[8px] text-slate-300">
        Trusted Used Car Dealer
      </p>



      <h1 class="text-6xl font-black leading-tight text-white">

        Temukan Mobil Bekas
        Berkualitas dengan
        Harga Terbaik

      </h1>



      <p class="mt-8 text-xl text-slate-300">

        FOLLOW OUR IG @GARAGE88JAKARTA

      </p>



      <!-- SEARCH -->

      <form
        action="/stock"
        method="GET"
        class="mt-10 flex max-w-2xl gap-4"
      >


        <input

          type="text"

          name="q"

          placeholder="Cari Toyota, Zenix, Fortuner..."

          class="
            flex-1
            rounded-xl
            border
            border-slate-300
            bg-white
            px-5
            py-4
            text-lg
            text-slate-900
            placeholder:text-slate-400
            outline-none
            focus:border-red-600
            focus:ring-2
            focus:ring-red-200
          "

        />



        <button

          type="submit"

          class="
            rounded-xl
            bg-red-600
            px-8
            font-semibold
            text-white
            hover:bg-red-700
          "

        >

          Cari

        </button>


      </form>




      <a

        href="#stock"

        class="
          mt-10
          inline-block
          rounded-xl
          bg-red-600
          px-8
          py-4
          font-semibold
          text-white
          hover:bg-red-700
        "

      >

        Lihat Stock

      </a>



    </div>

  </div>

</section>
---
import type { Car } from "../types/car";
import { formatPrice } from "../utils/formatPrice";
import { formatKm } from "../utils/formatKm";

interface Props {
  car: Car;
}

const { car } = Astro.props;
---

<div class="bg-white rounded-2xl shadow hover:shadow-xl transition overflow-hidden">

  <div class="aspect-[16/10] bg-slate-200 flex items-center justify-center">

    <span class="text-slate-400">
      No Image
    </span>

  </div>

  <div class="p-5">

    <p class="text-sm text-slate-500">

      {car.brand}

    </p>

    <h3 class="font-bold text-xl mt-1">

      {car.model}

    </h3>

    <p class="text-slate-500">

      {car.variant}

    </p>

    <div class="mt-5 flex justify-between text-sm">

      <span>

        {car.year}

      </span>

      <span>

        {formatKm(car.odometer)} KM

      </span>

    </div>

    <div class="mt-6">

      <p class="text-red-600 font-bold text-2xl">

        Rp {formatPrice(car.credit_price)}

      </p>

      <p class="text-sm text-slate-500">

        DP Mulai Rp {formatPrice(car.dp)}

      </p>

    </div>

  </div>

</div>
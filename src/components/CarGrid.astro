---
import type { Car } from "../types/car";
import CarCard from "./CarCard.astro";

interface Props {

  cars: Car[];

  page?: number;

  totalPages?: number;

  query?: string;

  price?: string;

}


const {

  cars,

  page = 1,

  totalPages = 1,

  query = "",

  price = ""

} = Astro.props;

---

<div
id="car-grid"
class="
grid
gap-6
md:grid-cols-2
lg:grid-cols-3
"
>


{
cars.map((car)=>(
  <CarCard car={car}/>
))
}


</div>



{
page < totalPages && (

<div
id="infinite-scroll-zone"
class="
mt-10
flex
min-h-[90px]
items-center
justify-center
text-center
"
>

<div>


<div
id="infinite-loader"
class="
hidden
items-center
justify-center
gap-3
text-sm
font-semibold
text-slate-500
"
>

<span
class="
inline-block
h-5
w-5
animate-spin
rounded-full
border-2
border-slate-300
border-t-red-600
"
>
</span>

<span>
Loading unit berikutnya...
</span>

</div>


<div
id="scroll-sentinel"
data-page={page}
data-total-pages={totalPages}
data-query={query}
data-price={price}
class="
h-4
w-full
"
>
</div>


</div>

</div>

)

}



{
page >= totalPages && cars.length > 0 && (

<div
class="
mt-10
text-center
text-sm
font-medium
text-slate-400
"
>
Semua unit sudah ditampilkan
</div>

)

}





<script is:inline>

  // @ts-nocheck

  const sentinel =
    document.getElementById(
      "scroll-sentinel"
    );


  const loader =
    document.getElementById(
      "infinite-loader"
    );


  const zone =
    document.getElementById(
      "infinite-scroll-zone"
    );


  const grid =
    document.getElementById(
      "car-grid"
    );


  let isLoading =
    false;


  let observer =
    null;



  /* =====================================================
     SHOW LOADER
     ===================================================== */

  function showLoader() {

    if (!loader) {
      return;
    }


    loader.classList.remove(
      "hidden"
    );


    loader.classList.add(
      "flex"
    );

  }



  /* =====================================================
     HIDE LOADER
     ===================================================== */

  function hideLoader() {

    if (!loader) {
      return;
    }


    loader.classList.add(
      "hidden"
    );


    loader.classList.remove(
      "flex"
    );

  }



  /* =====================================================
     FINISH
     ===================================================== */

  function finishInfiniteScroll() {

    if (observer) {

      observer.disconnect();

    }


    if (zone) {

      zone.innerHTML =
        `
          <div
            class="
              py-4
              text-center
              text-sm
              font-medium
              text-slate-400
            "
          >
            Semua unit sudah ditampilkan
          </div>
        `;

    }

  }



  /* =====================================================
     LOAD NEXT PAGE
     ===================================================== */

  async function loadNextPage() {

    if (
      !sentinel ||
      !grid ||
      isLoading
    ) {
      return;
    }


    let page =
      Number(
        sentinel.dataset.page ||
        1
      );


    const totalPages =
      Number(
        sentinel.dataset.totalPages ||
        1
      );


    const query =
      sentinel.dataset.query ||
      "";


    const price =
      sentinel.dataset.price ||
      "";


    if (
      page >=
      totalPages
    ) {

      finishInfiniteScroll();

      return;

    }


    isLoading =
      true;


    showLoader();


    const nextPage =
      page + 1;


    let url =
      `/api/cars-html?page=${nextPage}`;


    if (query) {

      url +=
        `&q=${encodeURIComponent(query)}`;

    }


    if (price) {

      url +=
        `&price=${encodeURIComponent(price)}`;

    }


    try {

      const response =
        await fetch(
          url,
          {
            cache:
              "no-store"
          }
        );


      if (!response.ok) {

        throw new Error(
          `HTTP ${response.status}`
        );

      }


      const result =
        await response.json();


      if (
        result.html &&
        String(
          result.html
        ).trim()
      ) {

        grid.insertAdjacentHTML(
          "beforeend",
          result.html
        );

      }


      page =
        nextPage;


      sentinel.dataset.page =
        String(page);


      if (
        page >=
        totalPages
      ) {

        finishInfiniteScroll();

      }


    } catch (error) {

      console.error(
        "Infinite scroll error:",
        error
      );


      if (zone) {

        zone.innerHTML =
          `
            <div
              class="
                py-4
                text-center
              "
            >

              <p
                class="
                  text-sm
                  font-medium
                  text-red-600
                "
              >
                Gagal memuat unit berikutnya
              </p>

              <button
                id="retry-infinite-scroll"
                type="button"
                class="
                  mt-3
                  rounded-xl
                  bg-red-600
                  px-5
                  py-2.5
                  text-sm
                  font-semibold
                  text-white
                "
              >
                Coba Lagi
              </button>

            </div>
          `;


        const retryButton =
          document.getElementById(
            "retry-infinite-scroll"
          );


        retryButton?.addEventListener(
          "click",
          () => {

            location.reload();

          }
        );

      }


      if (observer) {

        observer.disconnect();

      }

    } finally {

      isLoading =
        false;


      hideLoader();

    }

  }



  /* =====================================================
     OBSERVER
     ===================================================== */

  if (
    sentinel &&
    grid
  ) {

    observer =
      new IntersectionObserver(
        (entries) => {

          const entry =
            entries[0];


          if (
            !entry ||
            !entry.isIntersecting ||
            isLoading
          ) {
            return;
          }


          loadNextPage();

        },
        {

          /*
           * Mulai load sebelum benar-benar
           * sampai bawah.
           *
           * Jadi terasa mulus dan user tidak
           * melihat jeda.
           */

          rootMargin:
            "700px 0px",

          threshold:
            0

        }
      );


    observer.observe(
      sentinel
    );

  }

</script>
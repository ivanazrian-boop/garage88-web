---
import type { Car } from "../types/car";
import { formatPrice } from "../utils/formatPrice";
import { formatKm } from "../utils/formatKm";


interface Props {
  car: Car;
}


const { car } = Astro.props;


const placeholder =
"https://placehold.co/800x600/f1f5f9/64748b?text=Garage88";


const image =
  car.images && car.images.length > 0
    ? [...car.images]
        .sort(
          (a,b)=>
          a.sort_order - b.sort_order
        )[0].image_url
    : placeholder;

---

<article
class="
overflow-hidden
rounded-2xl
border
border-slate-200
bg-white
shadow-sm
transition
hover:-translate-y-1
hover:shadow-lg
"
>


<a href={`/detail/${car.slug}`}>

<div
class="
relative
aspect-[4/3]
bg-slate-100
"
>


<img
src={image}
alt={`${car.brand} ${car.model}`}
class="
h-full
w-full
object-cover
"
loading="lazy"
/>



<span
class="
absolute
left-3
top-3
rounded-full
bg-red-600
px-3
py-1
text-xs
font-bold
text-white
"
>
⭐ FEATURED
</span>



</div>

</a>




<div class="p-3">


<p class="text-xs text-slate-500">
{car.year}
</p>


<h3
class="
mt-1
line-clamp-2
text-sm
font-bold
text-slate-900
"
>
{car.brand} {car.model}
</h3>



<p
class="
mt-3
text-xl
font-extrabold
text-red-600
"
>
{formatPrice(car.credit_price)}
</p>



<div
class="
mt-3
flex
justify-between
text-xs
text-slate-500
"
>

<span>
{car.fuel ?? "-"}
</span>


<span>
{formatKm(car.odometer)}
</span>


</div>


</div>


</article>
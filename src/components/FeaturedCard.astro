---
import type { Car } from "../types/car";
import { formatPrice } from "../utils/formatPrice";
import { formatKm } from "../utils/formatKm";


interface Props {
  car: Car;
}


const { car } = Astro.props;


const placeholder =
"https://placehold.co/800x600/f1f5f9/64748b?text=Garage88";


const image =
  car.images && car.images.length > 0
    ? [...car.images]
        .sort(
          (a,b) =>
          a.sort_order - b.sort_order
        )[0].image_url
    : placeholder;

---


<article
class="
overflow-hidden
rounded-2xl
border
border-slate-200
bg-white
shadow-sm
transition
hover:-translate-y-1
hover:shadow-lg
"
>


<a href={`/detail/${car.slug}`}>

<div
class="
relative
aspect-square
bg-slate-100
"
>


<img
src={image}
alt={`${car.brand} ${car.model}`}
class="
h-full
w-full
object-cover
"
loading="lazy"
/>


<!-- FEATURED BADGE -->

<span
class="
absolute
left-2
top-2
rounded-full
bg-red-600
px-2
py-0.5
text-[9px]
font-bold
text-white
"
>
FEATURED
</span>



<!-- FUEL -->

{
car.fuel && (

<span
class="
absolute
right-2
top-2
rounded-full
bg-black/70
px-2
py-0.5
text-[9px]
font-bold
text-white
"
>
{car.fuel}
</span>

)
}


</div>

</a>





<div
class="
p-3
md:p-4
"
>


<!-- YEAR -->

<p
class="
text-xs
text-slate-500
"
>
{car.year}
</p>




<!-- BRAND MODEL -->

<h3
class="
mt-1
text-base
font-bold
leading-tight
text-slate-900
md:text-lg
"
>
{car.brand} {car.model}
</h3>




<!-- TYPE / VARIANT -->

<p
class="
mt-1
line-clamp-2
text-sm
text-slate-500
"
>
{car.variant}
</p>






<!-- PRICE -->

<p
class="
mt-3
text-xl
font-extrabold
text-red-600
md:text-2xl
"
>
{formatPrice(car.credit_price)}
</p>





<!-- DP -->

<p
class="
mt-1
text-sm
font-semibold
text-slate-500
"
>
DP Mulai {formatPrice(car.dp)}
</p>






<!-- KM -->

<div
class="
mt-3
text-xs
text-slate-500
"
>

{formatKm(car.odometer)} KM

</div>



</div>


</article>
---
const menus = [
  {
    name: "Home",
    href: "/",
  },
  {
    name: "Stock",
    href: "/stock",
  },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200 bg-white/95 backdrop-blur">

  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-6">


    <!-- Logo -->

    <a
      href="/"
      class="text-3xl font-extrabold tracking-tight text-red-600"
    >
      Garage88
    </a>



    <!-- Menu -->

    <nav class="flex items-center gap-8">


      {
        menus.map((menu) => (

          <a
            href={menu.href}
            class="
              text-base
              font-semibold
              text-slate-700
              transition
              hover:text-red-600
            "
          >

            {menu.name}

          </a>

        ))
      }


    </nav>




    <!-- WhatsApp -->

    <a
  href="https://wa.me/6281385226049"
  target="_blank"
  rel="noopener noreferrer"
  onclick="
  fbq('track','Lead');
  window.trackWhatsApp && window.trackWhatsApp()
  "
  class="
    rounded-xl
    bg-green-600
    px-5
    py-3
    text-sm
    font-semibold
    text-white
    transition
    hover:bg-green-700
  "
>
  WhatsApp
</a>


  </div>


</header>
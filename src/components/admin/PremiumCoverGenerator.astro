---
interface Props {
  car: {
    id: string;
    cover_source_image_url?: string | null;
  };
  adminKey: string;
}

const { car, adminKey } = Astro.props;
const hasSourceImage = Boolean(car.cover_source_image_url?.trim());
---

<div class="mt-3" data-premium-cover-generator data-car-id={car.id} data-admin-key={adminKey}>
  <button
    type="button"
    data-premium-generate-button
    disabled={!hasSourceImage}
    class="w-full rounded-xl bg-orange-500 px-4 py-3 text-sm font-bold text-white hover:bg-orange-600 disabled:opacity-50"
  >
    Generate Premium Cover (IG)
  </button>

  <p class="mt-1 text-[11px] text-slate-500">
    Mengganti IG Cover. Meta Cover tidak berubah.
  </p>

  {!hasSourceImage && (
    <p class="mt-1 text-xs font-semibold text-red-600">
      Upload PhotoRoom polos terlebih dahulu.
    </p>
  )}

  <p data-premium-status class="mt-2 hidden text-sm" aria-live="polite"></p>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-premium-cover-generator]").forEach((container) => {
    if (container.dataset.bound === "true") return;
    container.dataset.bound = "true";

    const button = container.querySelector<HTMLButtonElement>("[data-premium-generate-button]");
    const status = container.querySelector<HTMLParagraphElement>("[data-premium-status]");
    const carId = container.dataset.carId;
    const adminKey = container.dataset.adminKey || "";

    button?.addEventListener("click", async () => {
      if (!carId || !button || button.disabled) return;

      button.disabled = true;
      button.textContent = "Generating Premium...";

      if (status) {
        status.className = "mt-2 text-sm text-slate-600";
        status.textContent = "Sedang membuat cover...";
      }

      try {
        const response = await fetch(
          `/api/generate-premium-cover/${encodeURIComponent(carId)}?key=${encodeURIComponent(adminKey)}`,
          {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({}),
          },
        );

        const result = await response.json() as {
          ok?: boolean;
          ig_image_url?: string;
          error?: string;
        };

        if (!response.ok || !result.ok || !result.ig_image_url) {
          throw new Error(result.error || `Gagal generate (HTTP ${response.status})`);
        }

        if (status) {
          status.className = "mt-2 text-sm text-emerald-700";
          status.textContent = "Berhasil! IG Cover diperbarui.";
        }

        button.textContent = "IG Cover Diperbarui";
        window.setTimeout(() => window.location.reload(), 700);
      } catch (error) {
        button.disabled = false;
        button.textContent = "Generate Premium Cover (IG)";

        if (status) {
          status.className = "mt-2 text-sm text-red-600";
          status.textContent = error instanceof Error ? error.message : String(error);
        }
      }
    });
  });
</script>

---
import "../styles/global.css";

interface Props {
  title?: string;
}

const {
  title = "Garage88 | Mobil Bekas Berkualitas",
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>

    <meta
      name="description"
      content="Garage88 - Mobil Bekas Berkualitas"
    />
  </head>

  <body class="bg-slate-100 text-slate-900">
    <slot />
  </body>
</html>
---
import MainLayout from "../layouts/MainLayout.astro";
import Navbar from "../components/Navbar.astro";
import Hero from "../components/Hero.astro";
import Footer from "../components/Footer.astro";
import CarGrid from "../components/CarGrid.astro";

import { getCarsPaginated } from "../services/cars.service";


const {
  cars,
  totalPages
} = await getCarsPaginated(1);

---

<MainLayout title="Garage88">

  <Navbar />

  <Hero />


  <main>

    <section
      id="stock"
      class="container py-16"
    >


      <div
        class="
        mb-10
        flex
        items-center
        justify-between
        "
      >

        <div>

          <h2 class="text-4xl font-bold">
            Stock Mobil
          </h2>


          <p class="mt-2 text-slate-500">
            {cars.length} Unit Tersedia
          </p>


        </div>


      </div>



      <CarGrid

        cars={cars}

        page={1}

        totalPages={totalPages}

      />



    </section>


  </main>



  <Footer />


</MainLayout>
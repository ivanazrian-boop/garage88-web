---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";

import FeaturedCard from "../../components/FeaturedCard.astro";
import StockCard from "../../components/StockCard.astro";

import {
  getFeaturedCars,
  getCarsPaginated
} from "../../services/cars.service";



const featuredCars =
  await getFeaturedCars();



const {
  cars: stockCars,
  totalPages
} =
  await getCarsPaginated(1);

---

<MainLayout title="Featured Collection | Garage88">


<Navbar />



<!-- HERO -->

<section
class="
bg-slate-900
py-6
md:py-8
"
>


<div
class="
container
px-5
md:px-0
"
>


<p
class="
text-xs
font-bold
tracking-[0.4em]
uppercase
text-red-500
"
>
FEATURED COLLECTION
</p>



<h1
class="
mt-2
text-3xl
font-bold
text-white
md:text-4xl
"
>
Mobil Pilihan
</h1>



</div>


</section>






<!-- FEATURED -->

<main
class="
container
px-5
py-10
md:px-0
"
>


<div
class="
grid
grid-cols-2
gap-4
md:grid-cols-3
lg:grid-cols-4
"
>


{
featuredCars.map((car)=>(
  <FeaturedCard car={car}/>
))
}


</div>



<div
class="
mt-12
text-center
"
>


<a
href="/stock"
class="
inline-flex
rounded-xl
bg-red-600
px-8
py-3
font-semibold
text-white
transition
hover:bg-red-700
"
>
Lihat Semua Stock
</a>


</div>


</main>







<!-- PEMBATAS -->

<div
class="
container
px-5
md:px-0
"
>

<hr
class="
border-slate-200
"
/>

</div>








<!-- STOCK LAINNYA -->


<section
class="
container
px-5
py-12
md:px-0
"
>


<div
class="
mb-8
"
>


<h2
class="
text-3xl
font-bold
text-slate-900
"
>
Stock Lainnya Garage88
</h2>



<p
class="
mt-2
text-slate-500
"
>
Pilihan unit lainnya yang tersedia
</p>



</div>






<div
class="
grid
grid-cols-2
gap-4
md:grid-cols-3
lg:grid-cols-4
"
>


{
stockCars.map((car)=>(
  <StockCard car={car}/>
))
}


</div>






<div
class="
mt-10
text-center
"
>


<a
href="/stock"
class="
inline-flex
rounded-xl
border
border-slate-300
px-8
py-3
font-semibold
text-slate-900
transition
hover:bg-slate-100
"
>
Lihat Semua Stock
</a>


</div>



</section>






<Footer />


</MainLayout>
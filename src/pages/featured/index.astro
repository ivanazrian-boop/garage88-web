---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FeaturedCard from "../../components/FeaturedCard.astro";

import { getFeaturedCars } from "../../services/cars.service";


const cars =
  await getFeaturedCars();

---

<MainLayout title="Featured Collection | Garage88">


<Navbar />



<section class="bg-slate-900 py-10 md:py-12">


<div class="container px-5 md:px-0">


<p
class="
text-xs
font-bold
tracking-[0.4em]
uppercase
text-red-500
"
>
FEATURED COLLECTION
</p>



<h1
class="
mt-3
text-3xl
font-bold
text-white
md:text-4xl
"
>
Mobil Pilihan
</h1>


</div>


</section>






<main
class="
container
px-5
py-10
md:px-0
md:py-12
"
>



<div
class="
grid
grid-cols-2
gap-4
md:grid-cols-3
lg:grid-cols-4
"
>


{
cars.map((car)=>(
  <FeaturedCard car={car}/>
))
}


</div>





<div
class="
mt-12
text-center
"
>


<a
href="/stock"
class="
inline-flex
rounded-xl
bg-red-600
px-8
py-3
font-semibold
text-white
transition
hover:bg-red-700
"
>
Lihat Semua Stock
</a>


</div>



</main>





<Footer />


</MainLayout>
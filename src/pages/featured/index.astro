---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import FeaturedCard from "../../components/FeaturedCard.astro";

import { getFeaturedCars } from "../../services/cars.service";


const cars =
  await getFeaturedCars();

---

<MainLayout title="Featured Collection | Garage88">


<Navbar />



<section class="bg-slate-900 py-16">


<div class="container px-5 md:px-0">


<p
class="
text-sm
font-bold
tracking-[0.3em]
uppercase
text-red-500
"
>
FEATURED COLLECTION
</p>



<h1
class="
mt-4
text-4xl
font-bold
text-white
md:text-5xl
"
>
Mobil Pilihan Garage88
</h1>



<p
class="
mt-3
max-w-xl
text-slate-300
"
>
Unit terbaik pilihan Garage88 dengan kondisi terbaik dan siap dimiliki.
</p>



</div>


</section>





<main
class="
container
px-5
py-12
md:px-0
"
>



<div class="mb-8">


<h2 class="text-3xl font-bold">
⭐ Featured Cars
</h2>


<p class="mt-2 text-slate-500">
Pilihan mobil terbaik Garage88
</p>


</div>





<div
class="
grid
grid-cols-2
gap-4
md:grid-cols-3
lg:grid-cols-4
"
>


{
cars.map((car)=>(
  <FeaturedCard car={car}/>
))
}


</div>



</main>





<Footer />


</MainLayout>
---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CarGrid from "../../components/CarGrid.astro";

import {
  getCarsPaginated,
  searchCarsPaginated,
  filterCarsPaginated,
} from "../../services/cars.service";


const q =
  Astro.url.searchParams.get("q") ?? "";


const price =
  Astro.url.searchParams.get("price") ?? "";



let cars = [];

let totalPages = 1;



if(price){


  const result =
    await filterCarsPaginated(
      price,
      1
    );


  cars =
    result.cars;


  totalPages =
    result.totalPages;



}
else if(q){


  const result =
    await searchCarsPaginated(
      q,
      1
    );


  cars =
    result.cars;


  totalPages =
    result.totalPages;



}
else{


  const result =
    await getCarsPaginated(
      1
    );


  cars =
    result.cars;


  totalPages =
    result.totalPages;


}

---

<MainLayout title="Stock Mobil | Garage88">


<Navbar />



<section class="bg-slate-900 py-10 md:py-16">


<div class="container px-5 md:px-0">


<h1 class="text-3xl font-bold text-white md:text-4xl">
Stock Mobil
</h1>



<p class="mt-2 text-slate-300">
{cars.length} Unit Tersedia
</p>





<!-- SEARCH -->

<form
action="/stock"
method="GET"
class="
mt-8
flex
max-w-3xl
flex-col
gap-3
sm:flex-row
"
>


<input

type="text"

name="q"

value={q}

placeholder="Cari Toyota, Fortuner, Zenix..."

class="
flex-1
rounded-xl
border
border-slate-300
bg-white
px-5
py-3
text-base
text-slate-900
placeholder:text-slate-400
outline-none
focus:border-red-600
focus:ring-2
focus:ring-red-200
md:py-4
md:text-lg
"

/>



<button

type="submit"

class="
rounded-xl
bg-red-600
px-8
py-3
font-semibold
text-white
transition
hover:bg-red-700
md:py-4
"

>
Cari
</button>


</form>






<!-- FILTER HARGA -->


<div class="mt-8">


<h3 class="mb-4 text-lg font-bold text-white">
Budget Harga
</h3>



<div class="flex flex-wrap gap-3">


<a
href="/stock?price=0-150"
class="
rounded-full
bg-white
px-5
py-3
text-sm
font-semibold
text-slate-900
transition
hover:bg-red-600
hover:text-white
"
>
&lt; 150 JT
</a>



<a
href="/stock?price=150-250"
class="
rounded-full
bg-white
px-5
py-3
text-sm
font-semibold
text-slate-900
transition
hover:bg-red-600
hover:text-white
"
>
150 - 250 JT
</a>



<a
href="/stock?price=250-300"
class="
rounded-full
bg-white
px-5
py-3
text-sm
font-semibold
text-slate-900
transition
hover:bg-red-600
hover:text-white
"
>
250 - 300 JT
</a>



<a
href="/stock?price=300-up"
class="
rounded-full
bg-white
px-5
py-3
text-sm
font-semibold
text-slate-900
transition
hover:bg-red-600
hover:text-white
"
>
&gt; 300 JT
</a>


</div>


</div>



</div>


</section>





<main class="container px-5 py-10 md:px-0 md:py-12">



{
cars.length > 0

?

<CarGrid

cars={cars}

page={1}

totalPages={totalPages}

query={q}

price={price}

/>


:

<div
class="
rounded-xl
border
border-dashed
border-slate-300
py-20
text-center
"
>


<h2 class="text-2xl font-bold">
Mobil tidak ditemukan
</h2>


<p class="mt-2 text-slate-500">
Coba gunakan filter atau kata kunci lain.
</p>


</div>

}



</main>



<Footer />



</MainLayout>
---
import MainLayout from "../../layouts/MainLayout.astro";
import Navbar from "../../components/Navbar.astro";
import Footer from "../../components/Footer.astro";
import CarGrid from "../../components/CarGrid.astro";

import {
  getCars,
  searchCars,
} from "../../services/cars.service";


const q =
  Astro.url.searchParams.get("q") ?? "";


const cars =
  q
    ? await searchCars(q)
    : await getCars();

---

<MainLayout title="Stock Mobil | Garage88">


<Navbar />



<section class="bg-slate-900 py-10 md:py-16">


  <div class="container px-5 md:px-0">



    <h1 class="text-3xl font-bold text-white md:text-4xl">
      Stock Mobil
    </h1>



    <p class="mt-2 text-slate-300">
      {cars.length} Unit Tersedia
    </p>




    <form
      action="/stock"
      method="GET"
      class="
        mt-8
        flex
        max-w-3xl
        flex-col
        gap-3
        sm:flex-row
      "
    >



      <input

        type="text"

        name="q"

        value={q}

        placeholder="Cari Toyota, Fortuner, Zenix..."

        class="
          flex-1
          rounded-xl
          border
          border-slate-300
          bg-white
          px-5
          py-3
          text-base
          text-slate-900
          placeholder:text-slate-400
          outline-none
          focus:border-red-600
          focus:ring-2
          focus:ring-red-200
          md:py-4
          md:text-lg
        "

      />




      <button

        type="submit"

        class="
          rounded-xl
          bg-red-600
          px-8
          py-3
          font-semibold
          text-white
          transition
          hover:bg-red-700
          md:py-4
        "

      >

        Cari

      </button>



    </form>



  </div>


</section>





<main class="container px-5 py-10 md:px-0 md:py-12">



{
  cars.length > 0

  ?

  <CarGrid cars={cars} />

  :

  <div
    class="
      rounded-xl
      border
      border-dashed
      border-slate-300
      py-20
      text-center
    "
  >



    <h2 class="text-2xl font-bold">
      Mobil tidak ditemukan
    </h2>



    <p class="mt-2 text-slate-500">
      Coba gunakan kata kunci lain.
    </p>



  </div>

}



</main>





<Footer />



</MainLayout>
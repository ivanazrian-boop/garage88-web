---
import MainLayout from "../../layouts/MainLayout.astro";
import { createSupabaseServerClient } from "../../lib/supabaseServer";

const key = Astro.url.searchParams.get("key");
const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY) {
  return Astro.redirect("/");
}

const selectedStatus = Astro.url.searchParams.get("status") ?? "ALL";

const allowedStatuses = ["ALL", "NEW", "CONTACTED", "DEAL", "REJECTED"];

const statusFilter = allowedStatuses.includes(selectedStatus)
  ? selectedStatus
  : "ALL";

let leads: any[] = [];
let loadError = "";

try {
  const supabase = createSupabaseServerClient();

  let query = supabase
    .from("car_purchase_leads")
    .select("*")
    .order("created_at", { ascending: false })
    .limit(100);

  if (statusFilter !== "ALL") {
    query = query.eq("status", statusFilter);
  }

  const { data, error } = await query;

  if (error) {
    console.error("Admin leads query error:", error.message);
    loadError = "Gagal mengambil data leads dari database.";
  } else {
    leads = data ?? [];
  }
} catch (error) {
  console.error(
    "Admin leads error:",
    error instanceof Error ? error.message : "Unknown error"
  );

  loadError = "Koneksi database bermasalah. Periksa konfigurasi server.";
}

function formatDate(value: string) {
  if (!value) return "-";

  return new Date(value).toLocaleString("id-ID", {
    timeZone: "Asia/Jakarta",
    day: "2-digit",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

function formatPrice(value: number | null) {
  if (value === null || value === undefined) return "-";

  return new Intl.NumberFormat("id-ID", {
    style: "currency",
    currency: "IDR",
    maximumFractionDigits: 0,
  }).format(value);
}

function formatNumber(value: number | null) {
  if (value === null || value === undefined) return "-";

  return new Intl.NumberFormat("id-ID").format(value);
}

function whatsappUrl(value: string) {
  let phone = String(value ?? "").replace(/\D/g, "");

  if (phone.startsWith("0")) {
    phone = "62" + phone.slice(1);
  } else if (phone.startsWith("8")) {
    phone = "62" + phone;
  }

  return `https://wa.me/${phone}`;
}

function statusLabel(status: string) {
  const labels: Record<string, string> = {
    NEW: "New",
    CONTACTED: "Contacted",
    DEAL: "Deal",
    REJECTED: "Rejected",
  };

  return labels[status] ?? status;
}

function statusClass(status: string) {
  const classes: Record<string, string> = {
    NEW: "bg-blue-100 text-blue-700",
    CONTACTED: "bg-amber-100 text-amber-700",
    DEAL: "bg-green-100 text-green-700",
    REJECTED: "bg-red-100 text-red-700",
  };

  return classes[status] ?? "bg-slate-100 text-slate-700";
}
---

<MainLayout title="Leads Jual Mobil | Garage88">

  <section class="min-h-screen bg-slate-100 py-10">

    <div class="mx-auto max-w-7xl px-4 sm:px-6">

      <!-- HEADER -->
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">

        <div>
          <h1 class="text-3xl font-bold text-slate-900">
            Leads Jual Mobil
          </h1>

          <p class="mt-2 text-sm text-slate-500">
            Daftar calon penjual mobil dari BorongBoil
          </p>
        </div>

        <div class="flex flex-wrap gap-3">

          <a
            href={`/admin?key=${ADMIN_KEY}`}
            class="rounded-xl border border-slate-300 bg-white px-5 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50"
          >
            ← Dashboard
          </a>

          <a
            href={`/admin/leads?key=${ADMIN_KEY}${statusFilter !== "ALL" ? `&status=${statusFilter}` : ""}`}
            class="rounded-xl bg-red-600 px-5 py-3 text-sm font-semibold text-white hover:bg-red-700"
          >
            Refresh
          </a>

        </div>

      </div>

      <!-- SUMMARY -->
      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">

        <div class="rounded-2xl bg-white p-5 shadow-sm">
          <p class="text-sm text-slate-500">Data Ditampilkan</p>
          <p class="mt-2 text-3xl font-bold text-slate-900">
            {leads.length}
          </p>
        </div>

        <div class="rounded-2xl bg-white p-5 shadow-sm">
          <p class="text-sm text-slate-500">Filter Status</p>
          <p class="mt-2 text-xl font-bold text-slate-900">
            {statusFilter === "ALL" ? "Semua Status" : statusLabel(statusFilter)}
          </p>
        </div>

        <div class="rounded-2xl bg-white p-5 shadow-sm">
          <p class="text-sm text-slate-500">Sumber</p>
          <p class="mt-2 text-xl font-bold text-slate-900">
            BorongBoil
          </p>
        </div>

        <div class="rounded-2xl bg-white p-5 shadow-sm">
          <p class="text-sm text-slate-500">Batas Tampilan</p>
          <p class="mt-2 text-xl font-bold text-slate-900">
            100 Leads Terbaru
          </p>
        </div>

      </div>

      <!-- FILTER -->
      <div class="mt-8 rounded-2xl bg-white p-5 shadow-sm">

        <form method="GET" class="flex flex-col gap-3 sm:flex-row sm:items-end">

          <input type="hidden" name="key" value={ADMIN_KEY} />

          <div class="w-full sm:max-w-xs">

            <label for="status" class="mb-2 block text-sm font-semibold text-slate-700">
              Filter Status
            </label>

            <select
              id="status"
              name="status"
              class="w-full rounded-xl border border-slate-300 bg-white px-4 py-3 text-sm outline-none focus:border-red-500"
            >
              <option value="ALL" selected={statusFilter === "ALL"}>
                Semua Status
              </option>
              <option value="NEW" selected={statusFilter === "NEW"}>
                New
              </option>
              <option value="CONTACTED" selected={statusFilter === "CONTACTED"}>
                Contacted
              </option>
              <option value="DEAL" selected={statusFilter === "DEAL"}>
                Deal
              </option>
              <option value="REJECTED" selected={statusFilter === "REJECTED"}>
                Rejected
              </option>
            </select>

          </div>

          <button
            type="submit"
            class="rounded-xl bg-slate-900 px-6 py-3 text-sm font-semibold text-white hover:bg-slate-700"
          >
            Terapkan Filter
          </button>

        </form>

      </div>

      <!-- DATA TABLE -->
      <div class="mt-6 overflow-hidden rounded-2xl bg-white shadow-sm">

        <div class="border-b border-slate-200 px-5 py-4">
          <h2 class="font-bold text-slate-900">
            Daftar Leads
          </h2>

          <p class="mt-1 text-xs text-slate-500">
            Menampilkan maksimal 100 data terbaru
          </p>
        </div>

        {loadError ? (

          <div class="p-8 text-center">
            <p class="font-semibold text-red-600">{loadError}</p>
          </div>

        ) : leads.length === 0 ? (

          <div class="p-12 text-center">
            <p class="text-lg font-semibold text-slate-700">
              Belum ada leads
            </p>
            <p class="mt-2 text-sm text-slate-500">
              Data pengajuan jual mobil akan muncul di sini.
            </p>
          </div>

        ) : (

          <div class="overflow-x-auto">

            <table class="w-full min-w-[1050px] text-left text-sm">

              <thead class="bg-slate-50 text-xs uppercase text-slate-500">
                <tr>
                  <th class="px-5 py-4">Tanggal</th>
                  <th class="px-5 py-4">Pemilik</th>
                  <th class="px-5 py-4">Kendaraan</th>
                  <th class="px-5 py-4">Detail</th>
                  <th class="px-5 py-4">Harga Harapan</th>
                  <th class="px-5 py-4">Status</th>
                  <th class="px-5 py-4">Aksi</th>
                </tr>
              </thead>

              <tbody class="divide-y divide-slate-100">

                {leads.map((lead) => (

                  <tr class="align-top hover:bg-slate-50">

                    <td class="whitespace-nowrap px-5 py-5 text-xs text-slate-500">
                      {formatDate(lead.created_at)}
                    </td>

                    <td class="px-5 py-5">

                      <p class="font-bold text-slate-900">
                        {lead.owner_name}
                      </p>

                      <p class="mt-1 text-xs text-slate-500">
                        {lead.whatsapp}
                      </p>

                    </td>

                    <td class="px-5 py-5">

                      <p class="font-bold text-slate-900">
                        {lead.car_brand} {lead.car_model}
                      </p>

                      <p class="mt-1 text-xs text-slate-500">
                        Tahun {lead.car_year} · {lead.car_color}
                      </p>

                    </td>

                    <td class="px-5 py-5 text-xs text-slate-600">

                      <p>
                        KM: {formatNumber(lead.car_kilometer)}
                      </p>

                      <p class="mt-1">
                        Transmisi: {lead.transmission || "-"}
                      </p>

                      <p class="mt-1">
                        Lokasi: {lead.car_location || "-"}
                      </p>

                    </td>

                    <td class="whitespace-nowrap px-5 py-5 font-semibold text-slate-800">
                      {formatPrice(lead.expected_price)}
                    </td>

                    <td class="px-5 py-5">

                      <span class={`inline-flex rounded-full px-3 py-1 text-xs font-bold ${statusClass(lead.status)}`}>
                        {statusLabel(lead.status)}
                      </span>

                    </td>

                    <td class="px-5 py-5">

                      <a
                        href={whatsappUrl(lead.whatsapp)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex whitespace-nowrap rounded-lg bg-green-600 px-4 py-2 text-xs font-bold text-white hover:bg-green-700"
                      >
                        WhatsApp
                      </a>

                      {lead.notes && (
                        <p class="mt-2 max-w-[180px] text-xs text-slate-500">
                          Catatan: {lead.notes}
                        </p>
                      )}

                    </td>

                  </tr>

                ))}

              </tbody>

            </table>

          </div>

        )}

      </div>

      <p class="mt-5 text-xs text-slate-400">
        Garage88 Admin · Leads Jual Mobil · Data dari Supabase
      </p>

    </div>

  </section>

</MainLayout>

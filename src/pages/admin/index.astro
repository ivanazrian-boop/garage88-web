---
import MainLayout from "../../layouts/MainLayout.astro";

const key = Astro.url.searchParams.get("key");

const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY) {
  return Astro.redirect("/");
}
---

<MainLayout title="Garage88 Admin">

<section class="min-h-screen bg-slate-100 py-12">

<div class="mx-auto max-w-6xl px-6">

<h1 class="text-4xl font-bold">
Garage88 Admin
</h1>

<p class="mt-2 text-slate-500">
Dashboard Management Stock Mobil
</p>


<div class="mt-10 grid gap-6 md:grid-cols-3">


<div class="rounded-2xl bg-white p-6 shadow">

<p class="text-sm text-slate-500">
Total Stock
</p>

<p class="mt-3 text-4xl font-bold text-red-600">
0
</p>

</div>


<div class="rounded-2xl bg-white p-6 shadow">

<p class="text-sm text-slate-500">
Ready
</p>

<p class="mt-3 text-4xl font-bold text-green-600">
0
</p>

</div>


<div class="rounded-2xl bg-white p-6 shadow">

<p class="text-sm text-slate-500">
Featured
</p>

<p class="mt-3 text-4xl font-bold text-blue-600">
0
</p>

</div>


</div>


<div class="mt-10 rounded-2xl bg-white p-8 shadow">

<h2 class="text-2xl font-bold">
Menu
</h2>


<div class="mt-6 grid gap-4 md:grid-cols-4">


<a
href={`/admin/cars/new?key=${ADMIN_KEY}`}
class="rounded-xl bg-red-600 px-6 py-4 text-center font-semibold text-white hover:bg-red-700"
>
Tambah Mobil
</a>


<a
href={`/admin/cars?key=${ADMIN_KEY}`}
class="rounded-xl border px-6 py-4 text-center font-semibold hover:bg-slate-50"
>
Kelola Mobil
</a>


<a
href="/stock"
class="rounded-xl border px-6 py-4 text-center font-semibold hover:bg-slate-50"
>
Lihat Website
</a>


<a
href="/admin/logout"
class="rounded-xl border px-6 py-4 text-center font-semibold hover:bg-slate-50"
>
Logout
</a>


</div>

</div>


</div>

</section>

</MainLayout>
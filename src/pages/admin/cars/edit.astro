---
import MainLayout from "../../../layouts/MainLayout.astro";
import { supabase } from "../../../lib/supabase";

const key = Astro.url.searchParams.get("key");
const id = Astro.url.searchParams.get("id");

const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY || !id) {
  return Astro.redirect("/");
}


let message = "";


// Ambil data mobil

const { data: car, error } = await supabase
  .from("cars")
  .select("*")
  .eq("id", id)
  .single();


if (!car) {
  return Astro.redirect(
    `/admin/cars?key=${ADMIN_KEY}`
  );
}



// UPDATE

if (Astro.request.method === "POST") {


  const formData =
    await Astro.request.formData();



  const updateData = {


    brand:
      formData.get("brand")?.toString() || "",


    model:
      formData.get("model")?.toString() || "",


    variant:
      formData.get("variant")?.toString() || null,


    year:
      Number(formData.get("year")) || null,


    color:
      formData.get("color")?.toString() || null,


    fuel:
      formData.get("fuel")?.toString() || null,


    transmission:
      formData.get("transmission")?.toString() || null,


    odometer:
      Number(formData.get("odometer")) || 0,


    credit_price:
      Number(formData.get("credit_price")) || null,


    cash_price:
      Number(formData.get("cash_price")) || null,


    dp:
      Number(formData.get("dp")) || null,


    plate_number:
      formData.get("plate_number")?.toString() || null,


    tax_valid_until:
      formData.get("tax_valid_until")?.toString() || null,


    description:
      formData.get("description")?.toString() || null,


    status:
      formData.get("status")?.toString() || "READY",


    featured:
      formData.get("featured") === "on",


    updated_at:
      new Date().toISOString()

  };



  const { error:updateError } =
    await supabase
      .from("cars")
      .update(updateData)
      .eq("id", id);



  if(updateError){

    console.error(updateError);

    message =
      updateError.message;

  } else {

    message =
      "Mobil berhasil diupdate";

  }


}


---

<MainLayout title="Edit Mobil | Garage88 Admin">


<section class="min-h-screen bg-slate-100 py-12">


<div class="mx-auto max-w-5xl px-6">


<div class="flex items-center justify-between">

<div>

<h1 class="text-3xl font-bold">
Edit Mobil
</h1>

<p class="mt-2 text-slate-500">
{car.brand} {car.model}
</p>

</div>



<a
href={`/admin/cars?key=${ADMIN_KEY}`}
class="
rounded-xl
border
border-slate-300
bg-white
px-5
py-3
font-semibold
text-slate-700
hover:bg-slate-50
"
>
← Kembali ke Stock
</a>


</div>


{
message && (

<div class="mt-5 rounded-xl bg-green-100 p-4 text-green-700">
{message}
</div>

)

}



<form
method="POST"
class="mt-8 grid gap-6 rounded-2xl bg-white p-8 shadow"
>



<div class="grid gap-5 md:grid-cols-2">



<input
name="brand"
value={car.brand}
class="rounded-xl border p-4"
/>



<input
name="model"
value={car.model}
class="rounded-xl border p-4"
/>



<input
name="variant"
value={car.variant ?? ""}
class="rounded-xl border p-4"
/>



<input
name="year"
type="number"
value={car.year}
class="rounded-xl border p-4"
/>



<input
name="color"
value={car.color ?? ""}
class="rounded-xl border p-4"
/>



<select
name="fuel"
class="rounded-xl border p-4"
>

<option selected={car.fuel==="Bensin"}>
Bensin
</option>

<option selected={car.fuel==="Diesel"}>
Diesel
</option>

<option selected={car.fuel==="Hybrid"}>
Hybrid
</option>

<option selected={car.fuel==="Electric Vehicle"}>
Electric Vehicle
</option>

</select>




<select
name="transmission"
class="rounded-xl border p-4"
>

<option selected={car.transmission==="AT"}>
AT
</option>

<option selected={car.transmission==="MT"}>
MT
</option>

</select>




<input
name="odometer"
type="number"
value={car.odometer ?? ""}
placeholder="KM"
class="rounded-xl border p-4"
/>



<input
name="credit_price"
type="number"
value={car.credit_price ?? ""}
placeholder="Harga Kredit"
class="rounded-xl border p-4"
/>



<input
name="cash_price"
type="number"
value={car.cash_price ?? ""}
placeholder="Harga Cash"
class="rounded-xl border p-4"
/>



<input
name="dp"
type="number"
value={car.dp ?? ""}
placeholder="DP"
class="rounded-xl border p-4"
/>



<input
name="plate_number"
value={car.plate_number ?? ""}
placeholder="Plat"
class="rounded-xl border p-4"
/>



<input
name="tax_valid_until"
value={car.tax_valid_until ?? ""}
placeholder="Pajak"
class="rounded-xl border p-4"
/>



</div>




<textarea
name="description"
rows="5"
class="rounded-xl border p-4"
>
{car.description ?? ""}
</textarea>




<div>

<label class="font-semibold">
Status
</label>


<select
name="status"
class="mt-2 w-full rounded-xl border p-4"
>


<option
value="READY"
selected={car.status==="READY"}
>
READY
</option>


<option
value="BOOKED"
selected={car.status==="BOOKED"}
>
BOOKED
</option>


<option
value="SOLD"
selected={car.status==="SOLD"}
>
SOLD
</option>


</select>

</div>




<label class="flex items-center gap-3">

<input
type="checkbox"
name="featured"
checked={car.featured}
/>

Featured

</label>




<button
class="rounded-xl bg-red-600 px-8 py-4 font-semibold text-white"
>
Simpan Perubahan
</button>



</form>



</div>

</section>


</MainLayout>

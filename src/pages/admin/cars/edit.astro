  /* =====================================================
     NORMALIZE
     ===================================================== */

  function normalizeText(value) {

    return String(
      value || ""
    )
      .replace(
        /\u00a0/g,
        " "
      )
      .replace(
        /\r\n/g,
        "\n"
      );

  }


  /* =====================================================
     CLEAN TELEGRAM DESCRIPTION
     ===================================================== */

  function cleanTelegramDescription(
    text
  ) {

    return String(
      text || ""
    )

      /*
       * Hapus pola seperti:
       *
       * (Garage 88 Ciater) Grup C
       * (Garage88 Ciater) Group C
       * (AHA Gallery) Grup B
       * (AHA Nusantara) Grub A
       * (AHA Gajah Mada Cipete) Group C
       */

      .replace(
        /\s*\([^)\n]*(?:garage\s*88|garage88|aha)[^)\n]*\)\s*(?:group|grup|grub)\s*[a-z0-9]+\s*/gi,
        " "
      )

      /*
       * Hapus kalau cabang ada
       * dalam kurung tanpa Group.
       */

      .replace(
        /\s*\([^)\n]*(?:garage\s*88|garage88|aha)[^)\n]*\)\s*/gi,
        " "
      )

      /*
       * Hapus Group/Grup/Grub
       * yang tersisa.
       */

      .replace(
        /\b(?:group|grup|grub)\s+[a-z0-9]+\b/gi,
        ""
      )

      /*
       * Rapikan spasi sebelum newline.
       */

      .replace(
        /[ \t]+\n/g,
        "\n"
      )

      /*
       * Rapikan banyak spasi.
       */

      .replace(
        / {2,}/g,
        " "
      )

      /*
       * Maksimal 2 newline.
       */

      .replace(
        /\n{3,}/g,
        "\n\n"
      )

      .trim();

  }


  /* =====================================================
     PARSE MONEY
     ===================================================== */

  function parseMoney(
    raw,
    unit = ""
  ) {

    if (!raw) {
      return null;
    }

    const text =
      String(raw)
        .trim()
        .toLowerCase();

    const suffix =
      String(unit || "")
        .trim()
        .toLowerCase();


    const hasMillion =
      /^(jt|juta)$/.test(
        suffix
      );

    const hasBillion =
      /^(m|miliar|milyar)$/.test(
        suffix
      );


    if (
      hasMillion ||
      hasBillion
    ) {

      let normalized =
        text;


      /*
       * 35,5 → 35.5
       * 35.5 → 35.5
       */

      if (
        normalized.includes(
          ","
        )
      ) {

        normalized =
          normalized
            .replace(
              /\./g,
              ""
            )
            .replace(
              ",",
              "."
            );

      }


      const decimal =
        Number(
          normalized
        );


      if (
        !Number.isFinite(
          decimal
        )
      ) {
        return null;
      }


      if (hasBillion) {

        return Math.round(
          decimal *
          1_000_000_000
        );

      }


      return Math.round(
        decimal *
        1_000_000
      );

    }


    const digits =
      text.replace(
        /[^0-9]/g,
        ""
      );


    if (!digits) {
      return null;
    }


    const number =
      Number(
        digits
      );


    if (
      !Number.isFinite(
        number
      )
    ) {
      return null;
    }


    /*
     * OTR 215
     * dianggap 215JT
     */

    if (
      number > 0 &&
      number < 10000
    ) {

      return (
        number *
        1_000_000
      );

    }


    return number;

  }


  /* =====================================================
     MONEY PATTERN
     ===================================================== */

  const MONEY =
    "([0-9]+(?:[.,][0-9]+)?)\\s*(JT|JUTA|M|MILIAR|MILYAR)?";


  /* =====================================================
     FIND MONEY
     ===================================================== */

  function findMoney(
    text,
    labels
  ) {

    for (
      const label of labels
    ) {

      const regex =
        new RegExp(
          `${label}\\s*(?:[:=\\-]|RP\\.?\\s*)*\\s*${MONEY}`,
          "i"
        );


      const match =
        text.match(
          regex
        );


      if (match) {

        const value =
          parseMoney(
            match[1],
            match[2]
          );


        if (value) {
          return value;
        }

      }

    }


    return null;

  }


  /* =====================================================
     CREDIT / OTR
     ===================================================== */

  function findCreditPrice(
    text
  ) {

    return findMoney(
      text,
      [
        "HARGA\\s+CREDIT\\s*\\(\\s*OTR\\s*\\)",
        "HARGA\\s+KREDIT\\s*\\(\\s*OTR\\s*\\)",
        "HARGA\\s+CREDIT",
        "HARGA\\s+KREDIT",
        "OTR\\s*\\/\\s*KREDIT",
        "OTR\\s*\\/\\s*CREDIT",
        "OTR"
      ]
    );

  }


  /* =====================================================
     CASH
     ===================================================== */

  function findCashPrice(
    text
  ) {

    return findMoney(
      text,
      [
        "HARGA\\s+CASH",
        "CASH\\s+PRICE",
        "CASH"
      ]
    );

  }


  /* =====================================================
     ALL DP / TDP
     ===================================================== */

  function findAllDp(
    text
  ) {

    const results =
      [];


    const regex =
      /\b(?:TDP|DP)(?:\s+MULAI(?:\s+DARI)?)?\s*(?:[:=\-]|RP\.?\s*)*\s*([0-9]+(?:[.,][0-9]+)?)\s*(JT|JUTA|M|MILIAR|MILYAR)?/gi;


    let match;


    while (
      (
        match =
          regex.exec(
            text
          )
      ) !== null
    ) {

      const value =
        parseMoney(
          match[1],
          match[2]
        );


      if (
        value &&
        value > 0
      ) {

        results.push(
          value
        );

      }

    }


    return results;

  }


  /* =====================================================
     FORMAT RUPIAH
     ===================================================== */

  function formatRupiah(
    value
  ) {

    if (!value) {
      return "-";
    }


    return new Intl.NumberFormat(
      "id-ID",
      {
        style:
          "currency",

        currency:
          "IDR",

        maximumFractionDigits:
          0,
      }
    ).format(
      value
    );

  }


  /* =====================================================
     PARSE TELEGRAM
     ===================================================== */

  function parseTelegram() {

    const raw =
      normalizeText(
        telegramInput?.value
      ).trim();


    if (!raw) {

      alert(
        "Paste deskripsi Telegram dulu."
      );

      return;

    }


    const credit =
      findCreditPrice(
        raw
      );


    const cash =
      findCashPrice(
        raw
      );


    const allDp =
      findAllDp(
        raw
      );


    const lowestDp =
      allDp.length
        ? Math.min(
            ...allDp
          )
        : null;


    const cleanedDescription =
      cleanTelegramDescription(
        raw
      );


    /* =================================================
       UPDATE HANYA FIELD YANG DIIZINKAN
       ================================================= */


    if (
      credit !== null
    ) {

      creditInput.value =
        String(
          credit
        );

    }


    if (
      cash !== null
    ) {

      cashInput.value =
        String(
          cash
        );

    }


    if (
      lowestDp !== null
    ) {

      dpInput.value =
        String(
          lowestDp
        );

    }


    descriptionInput.value =
      cleanedDescription;


    /* =================================================
       RESULT
       ================================================= */


    resultCredit.textContent =
      credit
        ? formatRupiah(
            credit
          )
        : "Tidak ditemukan";


    resultCash.textContent =
      cash
        ? formatRupiah(
            cash
          )
        : "Tidak ditemukan";


    resultDp.textContent =
      lowestDp
        ? formatRupiah(
            lowestDp
          )
        : "Tidak ditemukan";


    resultBox.classList.remove(
      "hidden"
    );


    const changed =
      [];


    if (credit) {

      changed.push(
        "OTR"
      );

    }


    if (cash) {

      changed.push(
        "Cash"
      );

    }


    if (lowestDp) {

      changed.push(
        `DP terkecil dari ${allDp.length} data DP/TDP`
      );

    }


    changed.push(
      "Deskripsi"
    );


    resultMessage.textContent =
      `Terisi: ${changed.join(
        " • "
      )}. Cek dulu lalu klik Simpan Perubahan.`;

  }


  /* =====================================================
     EVENT
     ===================================================== */

  parseButton?.addEventListener(
    "click",
    parseTelegram
  );


  clearButton?.addEventListener(
    "click",
    () => {

      telegramInput.value =
        "";

      resultBox.classList.add(
        "hidden"
      );

    }
  );

</script>

</MainLayout>
---
import MainLayout from "../../../layouts/MainLayout.astro";
import { supabase } from "../../../lib/supabase";

const key = Astro.url.searchParams.get("key");
const id = Astro.url.searchParams.get("id");

const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY || !id) {
  return Astro.redirect("/");
}

let message = "";

// Ambil data mobil

const { data: car, error } = await supabase
  .from("cars")
  .select("*")
  .eq("id", id)
  .single();

if (!car) {
  return Astro.redirect(
    `/admin/cars?key=${ADMIN_KEY}`
  );
}


// UPDATE

if (Astro.request.method === "POST") {

  const formData =
    await Astro.request.formData();

  const updateData = {

    brand:
      formData.get("brand")?.toString() || "",

    model:
      formData.get("model")?.toString() || "",

    variant:
      formData.get("variant")?.toString() || null,

    year:
      Number(formData.get("year")) || null,

    branch:
      formData.get("branch")?.toString() || null,

    color:
      formData.get("color")?.toString() || null,

    fuel:
      formData.get("fuel")?.toString() || null,

    transmission:
      formData.get("transmission")?.toString() || null,

    odometer:
      Number(formData.get("odometer")) || 0,

    credit_price:
      Number(formData.get("credit_price")) || null,

    cash_price:
      Number(formData.get("cash_price")) || null,

    dp:
      Number(formData.get("dp")) || null,

    cash_only:
      formData.get("cash_only") === "on",

    plate_number:
      formData.get("plate_number")?.toString() || null,

    tax_valid_until:
      formData.get("tax_valid_until")?.toString() || null,

    description:
      formData.get("description")?.toString() || null,

    status:
      formData.get("status")?.toString() || "READY",

    featured:
      formData.get("featured") === "on",

    updated_at:
      new Date().toISOString()

  };

  const { error: updateError } =
    await supabase
      .from("cars")
      .update(updateData)
      .eq("id", id);

  if (updateError) {

    console.error(updateError);

    message =
      updateError.message;

  } else {

    message =
      "Mobil berhasil diupdate";

    // Supaya tampilan checkbox langsung mengikuti hasil save
    car.cash_only =
      updateData.cash_only;
  }

}

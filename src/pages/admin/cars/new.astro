<script is:inline>

function jtToNumber(value) {
  return Number(value) * 1000000;
}


/* =========================================================
   CABANG
   ========================================================= */

const BRANCH_ALIASES = [
  {
    name: "AHA Gajah Mada Cipondoh",
    aliases: [
      "aha gajah mada cipondoh",
      "gajah mada cipondoh",
      "aha gm cipondoh",
      "gm cipondoh"
    ]
  },

  {
    name: "AHA Gajah Mada Cipete",
    aliases: [
      "aha gajah mada cipete",
      "gajah mada cipete",
      "aha gm cipete",
      "gm cipete"
    ]
  },

  {
    name: "Garage88 Kebayoran",
    aliases: [
      "garage88 kebayoran",
      "garage 88 kebayoran",
      "g88 kebayoran",
      "kebayoran"
    ]
  },

  {
    name: "Garage88 Basura",
    aliases: [
      "garage88 basura",
      "garage 88 basura",
      "g88 basura",
      "basura"
    ]
  },

  {
    name: "Garage88 Joglo",
    aliases: [
      "garage88 joglo",
      "garage 88 joglo",
      "g88 joglo",
      "joglo"
    ]
  },

  {
    name: "Garage88 Ciater",
    aliases: [
      "garage88 ciater",
      "garage 88 ciater",
      "g88 ciater",
      "ciater"
    ]
  },

  {
    name: "AHA Nusantara",
    aliases: [
      "aha nusantara",
      "nusantara"
    ]
  },

  {
    name: "AHA Gallery",
    aliases: [
      "aha gallery",
      "gallery"
    ]
  },

  {
    name: "AHA ADEX",
    aliases: [
      "aha adex",
      "adex"
    ]
  }
];


function normalizeBranchText(value) {
  return String(value || "")
    .toLowerCase()
    .replace(/[._\-–—]+/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}


function findCanonicalBranch(value) {
  const normalized =
    normalizeBranchText(value);

  if (!normalized) {
    return "";
  }

  for (const branch of BRANCH_ALIASES) {
    for (const alias of branch.aliases) {
      const normalizedAlias =
        normalizeBranchText(alias);

      if (
        normalized === normalizedAlias ||
        normalized.includes(normalizedAlias)
      ) {
        return branch.name;
      }
    }
  }

  return "";
}


function extractBranchFromTitle(title) {
  const matches =
    [
      ...title.matchAll(
        /\(\s*([^)]+?)\s*\)/g
      )
    ];

  for (const match of matches) {
    const branch =
      findCanonicalBranch(
        match[1]
      );

    if (branch) {
      return {
        branch,
        matchedText: match[0]
      };
    }
  }

  return {
    branch: "",
    matchedText: ""
  };
}


function removeGroupInfo(value) {
  return String(value || "")
    .replace(
      /\s*[-–—]?\s*(?:group|grup|grub)\s+[a-z0-9]+\b/gi,
      ""
    );
}


function removeBranchParentheses(value) {
  return String(value || "")
    .replace(
      /\(\s*([^)]+?)\s*\)/g,
      function(fullMatch, inside) {
        const branch =
          findCanonicalBranch(inside);

        if (branch) {
          return "";
        }

        return fullMatch;
      }
    );
}


function cleanDescription(value) {
  let result =
    removeBranchParentheses(value);

  result =
    removeGroupInfo(result);

  result =
    result
      .split("\n")
      .map(function(line) {
        return line
          .replace(/\s+$/g, "")
          .trimEnd();
      })
      .join("\n")
      .replace(/[ \t]+\n/g, "\n")
      .replace(/\n{3,}/g, "\n\n")
      .trim();

  return result;
}


/* =========================================================
   TELEGRAM PARSER
   ========================================================= */

function parseTelegram() {
  const text =
    document
      .getElementById("telegramInput")
      .value
      .trim();

  if (!text) {
    alert("Paste Telegram dulu");
    return;
  }

  const firstLine =
    text
      .split("\n")[0]
      .trim();


  // CABANG

  const branchResult =
    extractBranchFromTitle(
      firstLine
    );

  document
    .getElementById("branch")
    .value =
      branchResult.branch || "";


  // CLEAN FIRST LINE

  let cleanFirstLine =
    firstLine;

  if (branchResult.matchedText) {
    cleanFirstLine =
      cleanFirstLine.replace(
        branchResult.matchedText,
        ""
      );
  }

  cleanFirstLine =
    removeGroupInfo(
      cleanFirstLine
    )
      .replace(/\s+/g, " ")
      .trim();


  // YEAR

  const year =
    cleanFirstLine.match(
      /\b20\d{2}\b/
    );

  if (year) {
    document
      .getElementById("year")
      .value =
        year[0];
  }


  // BRAND

  const brands = [
    "Toyota",
    "Honda",
    "Hyundai",
    "Mazda",
    "BMW",
    "Mercedes",
    "Audi",
    "Wuling",
    "Mitsubishi",
    "Nissan",
    "BYD"
  ];

  let brand = "";

  for (const b of brands) {
    if (
      cleanFirstLine
        .toLowerCase()
        .includes(
          b.toLowerCase()
        )
    ) {
      brand = b;
      break;
    }
  }

  document
    .getElementById("brand")
    .value =
      brand;


  // COLOR

  const colors = [
    "Putih",
    "Hitam",
    "Silver",
    "Grey",
    "Abu",
    "Merah",
    "Biru",
    "Hijau",
    "Coklat",
    "Metallic"
  ];

  for (const c of colors) {
    if (
      cleanFirstLine
        .toLowerCase()
        .includes(
          c.toLowerCase()
        )
    ) {
      document
        .getElementById("color")
        .value =
          c;

      break;
    }
  }


  // FUEL

  if (
    text
      .toLowerCase()
      .includes("hybrid")
  ) {
    document
      .getElementById("fuel")
      .value =
        "Hybrid";
  }
  else if (
    text
      .toLowerCase()
      .includes("diesel")
  ) {
    document
      .getElementById("fuel")
      .value =
        "Diesel";
  }
  else {
    document
      .getElementById("fuel")
      .value =
        "Bensin";
  }


  // TRANSMISSION

  if (
    cleanFirstLine.match(
      /\bAT\b/i
    )
  ) {
    document
      .getElementById("transmission")
      .value =
        "AT";
  }
  else if (
    cleanFirstLine.match(
      /\bMT\b/i
    )
  ) {
    document
      .getElementById("transmission")
      .value =
        "MT";
  }


  // MODEL + VARIANT

  let cleanTitle =
    cleanFirstLine
      .replace(
        /\(.*?\)/g,
        ""
      )
      .replace(
        year?.[0] || "",
        ""
      )
      .trim();

  if (brand) {
    cleanTitle =
      cleanTitle
        .replace(
          new RegExp(
            brand,
            "i"
          ),
          ""
        )
        .trim();
  }

  const words =
    cleanTitle
      .split(/\s+/)
      .filter(Boolean);

  if (words.length) {
    document
      .getElementById("model")
      .value =
        words[0];
  }

  if (words.length > 1) {
    document
      .getElementById("variant")
      .value =
        words
          .slice(1)
          .join(" ");
  }


  // KM

  let km =
    text.match(
      /(?:odometer|km)\s*[:\-]?\s*(\d+)\s*rb/i
    );

  if (!km) {
    km =
      text.match(
        /low km\s*(\d+)\s*rb/i
      );
  }

  if (km) {
    document
      .getElementById("odometer")
      .value =
        Number(km[1]) * 1000;
  }


  // CASH

  const cash =
    text.match(
      /cash\s+(\d+)\s*(jt|juta)/i
    );

  if (cash) {
    document
      .getElementById("cash_price")
      .value =
        jtToNumber(
          cash[1]
        );
  }


  // OTR CREDIT

  const otr =
    text.match(
      /(?:otr|harga kredit)\s+(\d+)\s*(jt|juta)/i
    );

  if (otr) {
    document
      .getElementById("credit_price")
      .value =
        jtToNumber(
          otr[1]
        );
  }


  // DP TERKECIL

  const dpMatches =
    [
      ...text.matchAll(
        /(?:tdp|dp)\s*(\d+)\s*(jt|juta)/gi
      )
    ];

  let dpValues = [];

  dpMatches.forEach(
    item => {
      dpValues.push(
        jtToNumber(
          item[1]
        )
      );
    }
  );

  if (dpValues.length) {
    document
      .getElementById("dp")
      .value =
        Math.min(
          ...dpValues
        );
  }


  // DESCRIPTION

  document
    .getElementById("description")
    .value =
      cleanDescription(
        text
      );


  alert(
    branchResult.branch
      ? `Data berhasil dikonversi\nCabang: ${branchResult.branch}`
      : "Data berhasil dikonversi\nCabang belum dikenali, pilih manual."
  );
}

</script>

</MainLayout>
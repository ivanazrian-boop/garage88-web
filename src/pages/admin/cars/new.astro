</div>

</section>


<script is:inline>

function cleanMoney(value){

  if(!value) return null;

  let number =
    Number(
      value
      .replace(/\./g,"")
      .replace(/,/g,"")
    );

  return number;

}



function jtToNumber(value){

  if(!value) return null;

  return Number(value) * 1000000;

}



function parseTelegram(){


const text =
document
.getElementById("telegramInput")
.value;



if(!text){

alert("Paste deskripsi Telegram dulu");

return;

}



const firstLine =
text
.split("\n")
[0]
.trim();


// =================
// YEAR
// =================

const year =
firstLine.match(/\b20\d{2}\b/);


if(year){

document.getElementById("year").value =
year[0];

}



// =================
// BRAND
// =================

const brands = [
"Toyota",
"Honda",
"Hyundai",
"Mazda",
"BMW",
"Mercedes",
"Audi",
"Wuling",
"Mitsubishi",
"Nissan",
"BYD",
"Volkswagen"
];


let brandFound = "";


brands.forEach(b=>{

if(
firstLine
.toLowerCase()
.includes(
b.toLowerCase()
)
){

brandFound=b;

}

});


document.getElementById("brand").value =
brandFound;



// =================
// COLOR
// =================

const colors=[
"Putih",
"Hitam",
"Silver",
"Grey",
"Abu",
"Merah",
"Biru",
"Hijau",
"Coklat"
];


colors.forEach(c=>{

if(
firstLine
.toLowerCase()
.includes(
c.toLowerCase()
)
){

document.getElementById("color").value=c;

}

});



// =================
// FUEL
// =================

if(text.toLowerCase().includes("hybrid")){

document.getElementById("fuel").value="Hybrid";

}
else if(text.toLowerCase().includes("diesel")){

document.getElementById("fuel").value="Diesel";

}
else{

document.getElementById("fuel").value="Bensin";

}



// =================
// TRANSMISSION
// =================

if(
firstLine.match(/\bAT\b/i)
){

document.getElementById("transmission").value="AT";

}

else if(
firstLine.match(/\bMT\b/i)
){

document.getElementById("transmission").value="MT";

}



// =================
// MODEL + VARIANT
// =================


let title =
firstLine
.replace(year?.[0] || "", "")
.replace(/\(.*?\)/g,"")
.trim();



if(brandFound){

title =
title
.replace(
new RegExp(brandFound,"i"),
""
)
.trim();

}



const words =
title.split(" ");



if(words.length){

document.getElementById("model").value =
words[0];

}



if(words.length > 1){

document.getElementById("variant").value =
words
.slice(1)
.join(" ");

}



// =================
// KM
// PRIORITY ODOMETER
// =================


let km =
text.match(
/(?:odometer|km)\s*[:\-]?\s*(\d+)\s*rb/i
);



if(!km){

km =
text.match(
/low km\s*(\d+)\s*rb/i
);

}



if(km){

document.getElementById("odometer").value =
Number(km[1]) * 1000;

}



// =================
// CASH
// =================


let cash =
text.match(
/cash\s+(\d+)\s*(jt|juta)/i
);



if(cash){

document.getElementById("cash_price").value =
jtToNumber(cash[1]);

}



// =================
// CREDIT / OTR
// =================


let otr =
text.match(
/(?:otr|harga kredit)\s+(\d+)\s*(jt|juta)/i
);



if(otr){

document.getElementById("credit_price").value =
jtToNumber(otr[1]);

}



// =================
// DP TERKECIL
// =================


const dpMatches =
[
...text.matchAll(
/(?:tdp|dp)\s*(\d+)\s*(jt|juta)/gi
)
];


let dpList=[];



dpMatches.forEach(item=>{

dpList.push(
jtToNumber(item[1])
);

});



if(dpList.length){

document.getElementById("dp").value =
Math.min(...dpList);

}



// =================
// DESCRIPTION
// =================


let description =
text
.split("\n")
.filter(line=>{

let lower =
line.toLowerCase();


return !(
lower.includes("cash") ||
lower.includes("otr") ||
lower.includes("tdp") ||
lower.includes("cicilan") ||
lower.includes("paket")
);

})
.join("\n")
.trim();



document.getElementById("description").value =
description;



alert("Data Telegram berhasil dikonversi");


}

</script>


</MainLayout>
---
import MainLayout from "../../../layouts/MainLayout.astro";
import { supabase } from "../../../lib/supabase";

const key = Astro.url.searchParams.get("key");

const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY) {
  return Astro.redirect("/");
}

let message = "";

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();

  const brand =
    formData.get("brand")?.toString().trim() || "";

  const model =
    formData.get("model")?.toString().trim() || "";

  const variant =
    formData.get("variant")?.toString().trim() || null;

  const year =
    Number(formData.get("year")) || null;

  const slug =
    `${brand}-${model}-${variant || ""}-${year}`
      .toLowerCase()
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/^-|-$/g, "");

  const car = {
    slug,

    brand,

    model,

    variant,

    year,

    branch:
      formData.get("branch")?.toString().trim() || null,

    color:
      formData.get("color")?.toString() || null,

    fuel:
      formData.get("fuel")?.toString() || null,

    transmission:
      formData.get("transmission")?.toString() || null,

    odometer:
      Number(formData.get("odometer")) || 0,

    credit_price:
      Number(formData.get("credit_price")) || null,

    cash_price:
      Number(formData.get("cash_price")) || null,

    dp:
      Number(formData.get("dp")) || null,

    cash_only:
      formData.get("cash_only") === "on",

    plate_number:
      formData.get("plate_number")?.toString() || null,

    tax_valid_until:
      null,

    description:
      formData.get("description")?.toString() || null,

    status:
      "READY",

    featured:
      formData.get("featured") === "on"
  };

  const { data, error } =
    await supabase
      .from("cars")
      .insert(car)
      .select()
      .single();

  if (error) {
    console.error(error);

    message = error.message;
  } else {
    return Astro.redirect(
      `/admin/cars/upload?id=${data.id}&key=${ADMIN_KEY}`
    );
  }
}
---


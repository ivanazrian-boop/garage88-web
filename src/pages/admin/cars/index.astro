---
import MainLayout from "../../../layouts/MainLayout.astro";
import {
getCars,
searchCars,
} from "../../../services/cars.service";

const key = Astro.url.searchParams.get("key");

const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY) {
return Astro.redirect("/");
}


const q =
Astro.url.searchParams.get("q") ?? "";


const status =
Astro.url.searchParams.get("status") ?? "READY";


const cover =
Astro.url.searchParams.get("cover") ?? "ALL";



const cars =
q
? await searchCars(q)
: await getCars();


const filteredCars =
cars.filter((car)=>{


if(
  status !== "ALL" &&
  car.status !== status
){
  return false;
}



if(
  cover === "META_BLANK" &&
  car.meta_image_url &&
  car.meta_image_url.trim() !== ""
){
  return false;
}



if(
  cover === "IG_BLANK" &&
  car.ig_image_url &&
  car.ig_image_url.trim() !== ""
){
  return false;
}



return true;


});
---


<MainLayout title="Stock Admin | Garage88">


<section class="min-h-screen bg-slate-100 py-12">

<div class="mx-auto max-w-7xl px-6">


<div class="flex items-center justify-between">

<div>

<h1 class="text-3xl font-bold">
Garage88 Stock Management
</h1>


<p class="mt-2 text-slate-500">
{filteredCars.length} Unit Mobil

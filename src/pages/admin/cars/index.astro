---
import MainLayout from "../../../layouts/MainLayout.astro";
import {
  getCars,
  searchCars,
} from "../../../services/cars.service";


const key = Astro.url.searchParams.get("key");

const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY) {
  return Astro.redirect("/");
}


const q =
  Astro.url.searchParams.get("q") ?? "";


const cars =
  q
    ? await searchCars(q)
    : await getCars();

---

<MainLayout title="Stock Admin | Garage88">


<section class="min-h-screen bg-slate-100 py-12">

<div class="mx-auto max-w-7xl px-6">


<div class="flex items-center justify-between">


<div>

<h1 class="text-3xl font-bold">
Garage88 Stock Management
</h1>


<p class="mt-2 text-slate-500">
{cars.length} Unit Mobil
</p>


</div>



<a
href={`/admin/cars/new?key=${ADMIN_KEY}`}
class="
rounded-xl
bg-red-600
px-6
py-3
font-semibold
text-white
hover:bg-red-700
"
>
+ Tambah Mobil
</a>


</div>





<form
method="GET"
class="
mt-8
flex
max-w-3xl
flex-col
gap-3
sm:flex-row
">


<input
type="hidden"
name="key"
value={ADMIN_KEY}
/>



<input
type="text"
name="q"
value={q}
placeholder="Cari Toyota, Fortuner, Zenix..."
class="
flex-1
rounded-xl
border
border-slate-300
bg-white
px-5
py-3
text-slate-900
"
/>



<button
type="submit"
class="
rounded-xl
bg-red-600
px-8
py-3
font-semibold
text-white
"
>
Cari
</button>


</form>





<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">


{
cars.length > 0 ? (

cars.map((car)=>{


const image =
car.images?.length
?
[...car.images]
.sort(
(a,b)=>a.sort_order-b.sort_order
)[0].image_url
:
"https://placehold.co/800x450?text=Garage88";



return (

<div class="overflow-hidden rounded-2xl bg-white shadow">


<img
src={image}
alt={`${car.brand} ${car.model}`}
class="aspect-video w-full object-cover"
/>



<div class="p-5">


<div class="flex items-start justify-between">


<div>

<h2 class="text-xl font-bold">
{car.brand} {car.model}
</h2>


<p class="text-sm text-slate-500">
{car.variant}
</p>


</div>


<span
class:list={[
"rounded-full px-3 py-1 text-xs font-semibold",
car.status === "READY"
?
"bg-green-100 text-green-700"
:
"bg-red-100 text-red-700"
]}
>
{car.status}
</span>


</div>

<!-- META COVER -->

<div class="mt-5">


<p class="mb-2 text-xs font-semibold text-slate-500">
META COVER
</p>



{
car.meta_image_url ? (

<img
src={car.meta_image_url}
alt="Meta Cover"
class="
h-32
w-24
rounded-xl
border
border-slate-200
object-cover
"
/>

) : (

<div
class="
flex
h-32
w-24
items-center
justify-center
rounded-xl
bg-slate-100
text-center
text-xs
font-semibold
text-slate-400
"
>
BELUM
ADA
COVER
</div>

)

}


</div>





<div class="mt-4 space-y-1 text-sm">


<p>
Tahun:
<b>{car.year}</b>
</p>


<p>
KM:
<b>
{car.odometer?.toLocaleString("id-ID")} KM
</b>
</p>


<p>
Harga Kredit:
<b>
Rp {car.credit_price?.toLocaleString("id-ID")}
</b>
</p>


<p>
Foto:
<b>
{car.images?.length ?? 0} pcs
</b>
</p>


</div>





<div class="mt-6 grid grid-cols-4 gap-3">



<a
href={`/admin/cars/photos?id=${car.id}&key=${ADMIN_KEY}`}
class="
rounded-xl
border
py-3
text-center
text-sm
font-semibold
hover:bg-slate-50
"
>
Foto
</a>



<a
href={`/admin/cars/edit?id=${car.id}&key=${ADMIN_KEY}`}
class="
rounded-xl
bg-slate-900
py-3
text-center
text-sm
font-semibold
text-white
"
>
Edit
</a>




<button
data-generate-id={car.id}
class="
cursor-pointer
rounded-xl
bg-yellow-400
py-3
text-center
text-sm
font-semibold
text-slate-900
hover:bg-yellow-300
"
>
{
car.meta_image_url
?
"Generate Ulang"
:
"Generate"
}
</button>




<a
href={`/admin/cars/delete?id=${car.id}&key=${ADMIN_KEY}`}
onclick="return confirm('Hapus mobil ini?')"
class="
rounded-xl
bg-red-600
py-3
text-center
text-sm
font-semibold
text-white
hover:bg-red-700
"
>
Hapus
</a>



</div>



</div>


</div>


)

})


) : (



<div class="col-span-full rounded-xl bg-white p-10 text-center">

<h2 class="text-xl font-bold">
Mobil tidak ditemukan
</h2>


<p class="mt-2 text-slate-500">
Coba gunakan kata kunci lain.
</p>


</div>


)

}



</div>


</div>


</section>





<script>

document
.querySelectorAll("[data-generate-id]")
.forEach((button)=>{


button.addEventListener(
"click",
async()=>{


const id =
button.getAttribute(
"data-generate-id"
);


if(!id) return;


button.innerText =
"Queue...";


button.disabled =
true;


console.log(
"GENERATE CLICK",
id
);



const response =
await fetch(
`/api/generate-meta/${id}`,
{
method:"POST"
}
);



const text =
await response.text();


console.log(
"API RESPONSE",
text
);



if(response.ok){


alert(
"Cover masuk antrian generate"
);


location.reload();


}
else{


alert(text);


button.disabled =
false;


button.innerText =
"Generate";


}


}

);


});


</script>


</MainLayout>
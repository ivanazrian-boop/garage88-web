rounded-xl
bg-red-600
px-8
py-3
text-sm
font-bold
text-white
transition
hover:bg-red-700
"
>
Cari
</button>

</form>





<div class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">


{
filteredCars.length > 0 ? (

filteredCars.map((car)=>{


const image =
car.images?.length
?
[...car.images]
.sort(
(a,b)=>a.sort_order-b.sort_order
)[0].image_url
:
"https://placehold.co/800x450?text=Garage88";


return (

<div class="overflow-hidden rounded-2xl bg-white shadow">


<img
src={image}
alt={`${car.brand} ${car.model}`}
class="aspect-video w-full object-cover"
/>


<div class="p-5">


<div class="flex items-start flex justify-between">


<div>

<h2 class="text-xl font-bold">
{car.brand} {car.model}
</h2>


<p class="text-sm text-slate-500">
{car.variant}
</p>

</div>


<span
class:list={[
"rounded-full px-3 py-1 text-xs font-semibold",
car.status === "READY"
?
"bg-green-100 text-green-700"
:
"bg-red-100 text-red-700"
]}
>
{car.status}
</span>


</div>





<!-- COVER AREA -->

<div class="mt-5 flex gap-5">


<!-- META COVER -->

<div>

<p class="mb-2 text-xs font-semibold text-slate-500">
META COVER
</p>


<label
class="
group
relative
block
h-32
w-24
cursor-pointer
"
>


{
car.meta_image_url ? (

<img
src={`${car.meta_image_url}?v=${Date.now()}`}
alt="Meta Cover"
class="
h-32
w-24
rounded-xl
border
border-slate-200
object-cover
transition
group-hover:opacity-70
"
/>

) : (

<div
class="
flex
h-32
w-24
items-center
justify-center
rounded-xl
bg-slate-100
text-xs
font-semibold
text-slate-400
text-center
"
>
BELUM
ADA
COVER
</div>

)

}


<input
type="file"
accept="image/*"
data-cover-upload={car.id}
class="hidden"
/>


</label>

{
  car.meta_image_url && (
    <a
      href={`${car.meta_image_url}?v=${Date.now()}`}
      target="_blank"
      rel="noopener noreferrer"
      class="
        mt-2
        inline-block
        text-xs
        font-semibold
        text-slate-500
        hover:text-slate-900
        hover:underline
      "
    >
      View Image
    </a>
  )
}

</div>





<!-- IG COVER -->

<div>

<p class="mb-2 text-xs font-semibold text-slate-500">
IG COVER
</p>


<label
class="
group
relative
block
h-32
w-24
cursor-pointer
"
>


{
car.ig_image_url ? (

<img
src={`${car.ig_image_url}?v=${Date.now()}`}
alt="IG Cover"
class="
h-32
w-24
rounded-xl
border
border-slate-200
object-cover
transition
group-hover:opacity-70
"
/>

) : (

<div
class="
flex
h-32
w-24
items-center
justify-center
rounded-xl
bg-slate-100
text-xs
font-semibold
text-slate-400
text-center
"
>
BELUM
ADA
COVER
</div>

)

}


<input
type="file"
accept="image/*"
data-ig-upload={car.id}
class="hidden"
/>


</label>

{
  car.ig_image_url && (
    <a
      href={`${car.ig_image_url}?v=${Date.now()}`}
      target="_blank"
      rel="noopener noreferrer"
      class="
        mt-2
        inline-block
        text-xs
        font-semibold
        text-slate-500
        hover:text-slate-900
        hover:underline
      "
    >
      View Image
    </a>
  )
}  
</div>


</div>

<div class="mt-4 space-y-1 text-sm">


<p>
Tahun:
<b>{car.year}</b>
</p>


<p>
KM:
<b>
{car.odometer?.toLocaleString("id-ID")} KM
</b>
</p>


<p>
Harga Kredit:
<b>
Rp {car.credit_price?.toLocaleString("id-ID")}
</b>
</p>


<p>
Foto:
<b>
{car.images?.length ?? 0} pcs
</b>
</p>


</div>





<div class="mt-6 grid grid-cols-4 gap-3">


<a
href={`/admin/cars/photos?id=${car.id}&key=${ADMIN_KEY}`}
class="
rounded-xl
border
py-3
text-center
text-sm
font-semibold
hover:bg-slate-50
"
>
Foto
</a>



<a
href={`/admin/cars/edit?id=${car.id}&key=${ADMIN_KEY}`}
class="
rounded-xl
bg-slate-900
py-3
text-center
text-sm
font-semibold
text-white
hover:bg-slate-700
"
>
Edit
</a>




<button
data-generate-id={car.id}
class="
cursor-pointer
rounded-xl
bg-yellow-400
py-3
text-center
text-sm
font-semibold
text-slate-900
hover:bg-yellow-300
transition
"
>

{
car.meta_image_url
?
"Generate Ulang"
:
"Generate"
}

</button>




<a
href={`/admin/cars/delete?id=${car.id}&key=${ADMIN_KEY}`}
onclick="return confirm('Hapus mobil ini?')"
class="
rounded-xl
bg-red-600
py-3
text-center
text-sm
font-semibold
text-white
hover:bg-red-700
"
>
Hapus
</a>


</div>



</div>


</div>


)

})

)

:

(

<div class="col-span-full rounded-xl bg-white p-10 text-center">

<h2 class="text-xl font-bold">
Mobil tidak ditemukan
</h2>


<p class="mt-2 text-slate-500">
Coba gunakan kata kunci lain.
</p>


</div>

)

}


</div>


</div>


</section>




<script>


// ==============================
// UPLOAD MANUAL META COVER
// ==============================

document
.querySelectorAll("[data-cover-upload]")
.forEach((input)=>{


input.addEventListener(
"change",
async()=>{


const file =
(input as HTMLInputElement)
.files?.[0];


if(!file){
return;
}


const id =
(input as HTMLElement)
.dataset.coverUpload;


if(!id){
return;
}



const formData =
new FormData();


formData.append(
"file",
file
);



try{


const response =
await fetch(

`/api/upload-meta-cover/${id}`,

{
method:"POST",
body:formData
}

);



const result =
await response.text();



console.log(
"UPLOAD META:",
result
);



if(response.ok){


alert(
"Meta Cover berhasil diganti"
);


location.reload();


}
else{


alert(result);


}


}

catch(error){


console.error(error);


alert(
"Gagal upload Meta Cover"
);


}


}

);


});





// ==============================
// UPLOAD MANUAL IG COVER
// ==============================


document
.querySelectorAll("[data-ig-upload]")
.forEach((input)=>{


input.addEventListener(
"change",
async()=>{


const file =
(input as HTMLInputElement)
.files?.[0];


if(!file){
return;
}


const id =
(input as HTMLElement)
.dataset.igUpload;


if(!id){
return;
}



const formData =
new FormData();


formData.append(
"file",
file
);



try{


const response =
await fetch(

`/api/upload-ig-cover/${id}`,

{
method:"POST",
body:formData
}

);



const result =
await response.text();



console.log(
"UPLOAD IG:",
result
);



if(response.ok){


alert(
"IG Cover berhasil diganti"
);


location.reload();


}
else{


alert(result);


}


}

catch(error){


console.error(error);


alert(
"Gagal upload IG Cover"
);


}


}

);


});





// ==============================
// GENERATE META COVER
// ==============================


document
.querySelectorAll("[data-generate-id]")
.forEach((button)=>{


button.addEventListener(
"click",
async()=>{


const id =
(button as HTMLElement)
.dataset.generateId;



if(!id){
return;
}



const btn =
button as HTMLButtonElement;



btn.innerText =
"Generating...";


btn.disabled =
true;




try{


const response =
await fetch(

`/api/generate-covers/${id}`,

{
method:"POST"
}

);



const text =
await response.text();



console.log(
"META RESPONSE:",
text
);



if(response.ok){


alert(
"IG Cover + Meta Cover berhasil dibuat"
);


location.reload();


}

else{


alert(text);


btn.disabled=false;


btn.innerText="Generate";


}


}

catch(error){


console.error(error);


alert(
"Gagal generate cover"
);


btn.disabled=false;


btn.innerText="Generate";


}


}

);


});


</script>


</MainLayout>
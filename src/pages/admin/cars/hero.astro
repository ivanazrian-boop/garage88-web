---
import MainLayout
  from "../../../layouts/MainLayout.astro";

import {
  getCars,
} from "../../../services/cars.service";


const key =
  Astro.url.searchParams.get(
    "key"
  );


const ADMIN_KEY =
  "garage88";


if (
  key !== ADMIN_KEY
) {

  return Astro.redirect(
    "/"
  );

}


const cars =
  await getCars();


const pendingCount =
  cars.filter(
    (car) =>
      car.cover_needs_regenerate
  ).length;
---


<MainLayout
  title="Bulk Hero Cover | Garage88"
>

  <section
    class="
      min-h-screen
      bg-slate-100
      py-8
    "
  >

    <div
      class="
        mx-auto
        max-w-[1600px]
        px-4
        sm:px-6
      "
    >


      <!-- ==============================
           HEADER
           ============================== -->

      <div
        class="
          flex
          flex-col
          gap-4
          lg:flex-row
          lg:items-center
          lg:justify-between
        "
      >

        <div>

          <div
            class="
              flex
              items-center
              gap-3
            "
          >

            <a
              href={`/admin/cars?key=${ADMIN_KEY}`}
              class="
                rounded-lg
                border
                border-slate-300
                bg-white
                px-3
                py-2
                text-sm
                font-semibold
                text-slate-700
                hover:bg-slate-50
              "
            >
              ← Admin
            </a>


            <h1
              class="
                text-2xl
                font-bold
                text-slate-900
                sm:text-3xl
              "
            >
              Bulk Hero Editor
            </h1>

          </div>


          <p
            class="
              mt-3
              text-sm
              text-slate-500
            "
          >
            Edit banyak Hero Cover sekaligus.
            Setelah Save, hanya unit yang berubah
            yang perlu di-generate ulang.
          </p>

        </div>


        <div
          class="
            flex
            flex-wrap
            gap-2
          "
        >

          <div
            class="
              rounded-xl
              bg-white
              px-4
              py-3
              shadow-sm
            "
          >

            <div
              class="
                text-[10px]
                font-bold
                uppercase
                text-slate-400
              "
            >
              READY
            </div>

            <div
              class="
                text-xl
                font-bold
                text-slate-900
              "
            >
              {cars.length}
            </div>

          </div>


          <div
            class="
              rounded-xl
              bg-amber-50
              px-4
              py-3
              shadow-sm
            "
          >

            <div
              class="
                text-[10px]
                font-bold
                uppercase
                text-amber-600
              "
            >
              Pending Generate
            </div>

            <div
              id="pending-count"
              class="
                text-xl
                font-bold
                text-amber-700
              "
            >
              {pendingCount}
            </div>

          </div>

        </div>

      </div>



      <!-- ==============================
           TOOLBAR
           ============================== -->

      <div
        class="
          sticky
          top-0
          z-30
          mt-6
          rounded-2xl
          border
          border-slate-200
          bg-white/95
          p-4
          shadow
          backdrop-blur
        "
      >

        <div
          class="
            flex
            flex-col
            gap-3
            xl:flex-row
            xl:items-center
          "
        >

          <input
            id="hero-search"
            type="text"
            placeholder="Cari Alphard, Zenix, Fortuner..."
            class="
              min-w-0
              flex-1
              rounded-xl
              border
              border-slate-300
              px-4
              py-3
              text-sm
              text-slate-900
              outline-none
              focus:border-blue-500
              focus:ring-2
              focus:ring-blue-100
            "
          />


          <label
            class="
              flex
              cursor-pointer
              items-center
              gap-2
              rounded-xl
              border
              border-slate-300
              px-4
              py-3
              text-sm
              font-semibold
              text-slate-700
            "
          >

            <input
              id="pending-only"
              type="checkbox"
              class="
                h-4
                w-4
              "
            />

            Pending saja

          </label>


          <button
            id="select-changed"
            type="button"
            class="
              rounded-xl
              bg-slate-900
              px-5
              py-3
              text-sm
              font-semibold
              text-white
              hover:bg-slate-700
            "
          >
            Pilih yang Berubah
          </button>


          <button
            id="clear-selection"
            type="button"
            class="
              rounded-xl
              border
              border-slate-300
              bg-white
              px-5
              py-3
              text-sm
              font-semibold
              text-slate-700
              hover:bg-slate-50
            "
          >
            Unselect
          </button>


          <button
            id="save-selected"
            type="button"
            class="
              rounded-xl
              bg-blue-600
              px-6
              py-3
              text-sm
              font-bold
              text-white
              hover:bg-blue-700
              disabled:cursor-not-allowed
              disabled:opacity-50
            "
          >
            Save Perubahan
          </button>

        </div>


        <div
          class="
            mt-3
            flex
            flex-wrap
            gap-4
            text-xs
            text-slate-500
          "
        >

          <span>
            Berubah:
            <b
              id="changed-count"
              class="text-slate-900"
            >
              0
            </b>
          </span>


          <span>
            Dipilih:
            <b
              id="selected-count"
              class="text-slate-900"
            >
              0
            </b>
          </span>


          <span>
            Ditampilkan:
            <b
              id="visible-count"
              class="text-slate-900"
            >
              {cars.length}
            </b>
          </span>

        </div>

      </div>



      <!-- ==============================
           TABLE
           ============================== -->

      <div
        class="
          mt-5
          overflow-hidden
          rounded-2xl
          border
          border-slate-200
          bg-white
          shadow-sm
        "
      >

        <div
          class="
            overflow-x-auto
          "
        >

          <table
            class="
              w-full
              min-w-[1100px]
              border-collapse
            "
          >

            <thead
              class="
                bg-slate-900
                text-left
                text-xs
                uppercase
                tracking-wide
                text-white
              "
            >

              <tr>

                <th
                  class="
                    w-14
                    px-4
                    py-4
                    text-center
                  "
                >
                  ✓
                </th>


                <th
                  class="
                    w-[390px]
                    px-4
                    py-4
                  "
                >
                  Mobil
                </th>


                <th
                  class="
                    px-4
                    py-4
                  "
                >
                  Hero Cover
                </th>


                <th
                  class="
                    w-[180px]
                    px-4
                    py-4
                  "
                >
                  Status
                </th>

              </tr>

            </thead>


            <tbody>

              {
                cars.map(
                  (
                    car,
                    index
                  ) => {

                    const carName =
                      [
                        car.brand,
                        car.model,
                        car.variant,
                        car.year,
                      ]
                        .filter(Boolean)
                        .join(" ")
                        .replace(
                          /\s+/g,
                          " "
                        )
                        .trim();


                    const hero =
                      String(
                        car.cover_hero_title ??
                        ""
                      );


                    return (

                      <tr
                        data-hero-row
                        data-id={car.id}
                        data-search={carName.toLowerCase()}
                        data-pending={
                          car.cover_needs_regenerate
                            ? "1"
                            : "0"
                        }
                        class="
                          border-b
                          border-slate-100
                          transition
                          last:border-b-0
                        "
                      >


                        <!-- CHECK -->

                        <td
                          class="
                            px-4
                            py-4
                            text-center
                            align-middle
                          "
                        >

                          <input
                            data-row-check
                            type="checkbox"
                            class="
                              h-5
                              w-5
                              cursor-pointer
                            "
                          />

                        </td>



                        <!-- CAR -->

                        <td
                          class="
                            px-4
                            py-4
                            align-middle
                          "
                        >

                          <div
                            class="
                              flex
                              items-center
                              gap-3
                            "
                          >

                            <div
                              class="
                                w-8
                                shrink-0
                                text-xs
                                font-semibold
                                text-slate-400
                              "
                            >
                              {index + 1}
                            </div>


                            {
                              car.ig_image_url ? (

                                <img
                                  src={`${car.ig_image_url}?v=${Date.now()}`}
                                  alt={carName}
                                  class="
                                    h-16
                                    w-14
                                    shrink-0
                                    rounded-lg
                                    border
                                    border-slate-200
                                    object-cover
                                  "
                                />

                              ) : (

                                <div
                                  class="
                                    flex
                                    h-16
                                    w-14
                                    shrink-0
                                    items-center
                                    justify-center
                                    rounded-lg
                                    bg-slate-100
                                    text-[9px]
                                    text-slate-400
                                  "
                                >
                                  NO COVER
                                </div>

                              )
                            }


                            <div
                              class="
                                min-w-0
                              "
                            >

                              <div
                                class="
                                  font-bold
                                  text-slate-900
                                "
                              >
                                {car.brand} {car.model}
                              </div>


                              <div
                                class="
                                  mt-1
                                  text-xs
                                  text-slate-500
                                "
                              >
                                {car.variant}
                              </div>


                              <div
                                class="
                                  mt-1
                                  text-xs
                                  font-semibold
                                  text-slate-400
                                "
                              >
                                {car.year}
                              </div>

                            </div>

                          </div>

                        </td>



                        <!-- HERO -->

                        <td
                          class="
                            px-4
                            py-4
                            align-middle
                          "
                        >

                          <input
                            data-hero-input
                            data-id={car.id}
                            data-original={hero}
                            type="text"
                            value={hero}
                            placeholder="AUTO HERO"
                            autocomplete="off"
                            class="
                              w-full
                              rounded-xl
                              border
                              border-slate-300
                              bg-white
                              px-4
                              py-3
                              text-base
                              font-bold
                              uppercase
                              text-slate-900
                              outline-none
                              transition
                              focus:border-blue-500
                              focus:ring-2
                              focus:ring-blue-100
                            "
                          />


                          <div
                            class="
                              mt-2
                              flex
                              gap-2
                            "
                          >

                            <span
                              data-changed-badge
                              class="
                                hidden
                                rounded-full
                                bg-blue-100
                                px-2
                                py-1
                                text-[10px]
                                font-bold
                                text-blue-700
                              "
                            >
                              CHANGED
                            </span>

                          </div>

                        </td>



                        <!-- STATUS -->

                        <td
                          class="
                            px-4
                            py-4
                            align-middle
                          "
                        >

                          <span
                            data-pending-badge
                            class:list={[
                              "inline-flex rounded-full px-3 py-1.5 text-[10px] font-bold",
                              car.cover_needs_regenerate
                                ? "bg-amber-100 text-amber-700"
                                : "bg-green-100 text-green-700"
                            ]}
                          >

                            {
                              car.cover_needs_regenerate
                                ? "PENDING GENERATE"
                                : "UP TO DATE"
                            }

                          </span>

                        </td>


                      </tr>

                    );

                  }
                )
              }

            </tbody>

          </table>

        </div>

      </div>



      <!-- ==============================
           BOTTOM HELP
           ============================== -->

      <div
        class="
          mt-6
          rounded-2xl
          bg-slate-900
          p-5
          text-sm
          text-slate-300
        "
      >

        Setelah selesai edit dan Save,
        jalankan di Mac:

        <code
          class="
            ml-2
            rounded
            bg-black
            px-2
            py-1
            font-mono
            text-green-400
          "
        >
          npx tsx scripts/regenerate-pending-covers-local.ts
        </code>

      </div>


    </div>

  </section>



  <script>

    const ADMIN_KEY =
      "garage88";


    const rows =
      Array.from(
        document.querySelectorAll(
          "[data-hero-row]"
        )
      );


    const searchInput =
      document.getElementById(
        "hero-search"
      );


    const pendingOnly =
      document.getElementById(
        "pending-only"
      );


    const changedCount =
      document.getElementById(
        "changed-count"
      );


    const selectedCount =
      document.getElementById(
        "selected-count"
      );


    const visibleCount =
      document.getElementById(
        "visible-count"
      );


    const saveButton =
      document.getElementById(
        "save-selected"
      );


    function normalizeHero(
      value
    ) {

      return String(
        value ?? ""
      )
        .replace(
          /\s+/g,
          " "
        )
        .trim()
        .toUpperCase();

    }


    function rowChanged(
      row
    ) {

      const input =
        row.querySelector(
          "[data-hero-input]"
        );


      if (!input) {
        return false;
      }


      return (
        normalizeHero(
          input.value
        ) !==
        normalizeHero(
          input.dataset.original ??
          ""
        )
      );

    }


    function refreshRow(
      row
    ) {

      const changed =
        rowChanged(
          row
        );


      const badge =
        row.querySelector(
          "[data-changed-badge]"
        );


      const check =
        row.querySelector(
          "[data-row-check]"
        );


      if (badge) {

        badge.classList.toggle(
          "hidden",
          !changed
        );

      }


      row.classList.toggle(
        "bg-blue-50",
        changed
      );


      if (
        changed &&
        check
      ) {

        check.checked =
          true;

      }


      refreshCounts();

    }


    function refreshCounts() {

      let changed =
        0;

      let selected =
        0;

      let visible =
        0;


      for (
        const row of
        rows
      ) {

        if (
          rowChanged(row)
        ) {
          changed++;
        }


        const check =
          row.querySelector(
            "[data-row-check]"
          );


        if (
          check?.checked
        ) {
          selected++;
        }


        if (
          row.style.display !==
          "none"
        ) {
          visible++;
        }

      }


      if (changedCount) {
        changedCount.textContent =
          String(changed);
      }


      if (selectedCount) {
        selectedCount.textContent =
          String(selected);
      }


      if (visibleCount) {
        visibleCount.textContent =
          String(visible);
      }


      if (saveButton) {
        saveButton.disabled =
          changed === 0;
      }

    }


    function applyFilter() {

      const q =
        String(
          searchInput?.value ??
          ""
        )
          .trim()
          .toLowerCase();


      const onlyPending =
        Boolean(
          pendingOnly?.checked
        );


      for (
        const row of
        rows
      ) {

        const search =
          String(
            row.dataset.search ??
            ""
          );


        const pending =
          row.dataset.pending ===
          "1";


        const matchesSearch =
          !q ||
          search.includes(q);


        const matchesPending =
          !onlyPending ||
          pending;


        row.style.display =
          matchesSearch &&
          matchesPending
            ? ""
            : "none";

      }


      refreshCounts();

    }


    for (
      const row of
      rows
    ) {

      const input =
        row.querySelector(
          "[data-hero-input]"
        );


      const check =
        row.querySelector(
          "[data-row-check]"
        );


      input?.addEventListener(
        "input",
        () => {

          refreshRow(
            row
          );

        }
      );


      check?.addEventListener(
        "change",
        refreshCounts
      );

    }


    searchInput?.addEventListener(
      "input",
      applyFilter
    );


    pendingOnly?.addEventListener(
      "change",
      applyFilter
    );


    document
      .getElementById(
        "select-changed"
      )
      ?.addEventListener(
        "click",
        () => {

          for (
            const row of
            rows
          ) {

            const check =
              row.querySelector(
                "[data-row-check]"
              );


            if (
              check &&
              rowChanged(row)
            ) {

              check.checked =
                true;

            }

          }


          refreshCounts();

        }
      );


    document
      .getElementById(
        "clear-selection"
      )
      ?.addEventListener(
        "click",
        () => {

          for (
            const row of
            rows
          ) {

            const check =
              row.querySelector(
                "[data-row-check]"
              );


            if (check) {
              check.checked =
                false;
            }

          }


          refreshCounts();

        }
      );


    saveButton
      ?.addEventListener(
        "click",
        async () => {

          const changedRows =
            rows.filter(
              (row) => {

                const check =
                  row.querySelector(
                    "[data-row-check]"
                  );


                return (
                  check?.checked &&
                  rowChanged(row)
                );

              }
            );


          if (
            changedRows.length ===
            0
          ) {

            alert(
              "Tidak ada Hero berubah yang dipilih."
            );

            return;

          }


          const items =
            changedRows.map(
              (row) => {

                const input =
                  row.querySelector(
                    "[data-hero-input]"
                  );


                return {

                  id:
                    row.dataset.id,

                  cover_hero_title:
                    normalizeHero(
                      input?.value ??
                      ""
                    ),

                };

              }
            );


          if (
            !confirm(
              `Save ${items.length} perubahan Hero?`
            )
          ) {
            return;
          }


          saveButton.disabled =
            true;

          saveButton.textContent =
            "Saving...";


          try {

            const response =
              await fetch(
                "/api/admin/bulk-hero",
                {

                  method:
                    "POST",

                  headers: {
                    "Content-Type":
                      "application/json",
                  },

                  body:
                    JSON.stringify({

                      key:
                        ADMIN_KEY,

                      items,

                    }),

                }
              );


            const result =
              await response.json();


            if (
              !response.ok
            ) {

              throw new Error(
                result.error ||
                "Gagal save Hero"
              );

            }


            const savedIds =
              new Set(
                result.saved_ids ??
                []
              );


            for (
              const row of
              changedRows
            ) {

              if (
                !savedIds.has(
                  row.dataset.id
                )
              ) {
                continue;
              }


              const input =
                row.querySelector(
                  "[data-hero-input]"
                );


              const check =
                row.querySelector(
                  "[data-row-check]"
                );


              const badge =
                row.querySelector(
                  "[data-changed-badge]"
                );


              const pendingBadge =
                row.querySelector(
                  "[data-pending-badge]"
                );


              if (input) {

                const normalized =
                  normalizeHero(
                    input.value
                  );


                input.value =
                  normalized;


                input.dataset.original =
                  normalized;

              }


              if (check) {
                check.checked =
                  false;
              }


              badge
                ?.classList
                .add(
                  "hidden"
                );


              row.classList.remove(
                "bg-blue-50"
              );


              row.dataset.pending =
                "1";


              if (pendingBadge) {

                pendingBadge.textContent =
                  "PENDING GENERATE";


                pendingBadge.className =
                  "inline-flex rounded-full bg-amber-100 px-3 py-1.5 text-[10px] font-bold text-amber-700";

              }

            }


            alert(
              `${result.saved} Hero berhasil disimpan.`
            );


            refreshCounts();


            applyFilter();


          } catch (error) {

            console.error(
              error
            );


            alert(
              error instanceof Error
                ? error.message
                : "Gagal Save Hero"
            );


          } finally {

            saveButton.disabled =
              false;

            saveButton.textContent =
              "Save Perubahan";

            refreshCounts();

          }

        }
      );


    applyFilter();

  </script>

</MainLayout>
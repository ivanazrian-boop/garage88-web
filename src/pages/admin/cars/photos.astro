<script is:inline>

import Sortable from "https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/+esm";


const grid = document.querySelector("#photo-grid");


if(grid){


  new Sortable(
    grid,
    {

      animation: 150,


      onEnd: async () => {


        const items =
          [...grid.children]
          .map((el, index) => ({

            id: el.dataset.id,

            sort_order: index + 1

          }));



        await fetch(
          "/api/admin/reorder-images",
          {

            method: "POST",

            headers: {
              "Content-Type": "application/json"
            },

            body: JSON.stringify({
              images: items
            })

          }
        );



        window.location.reload();


      }

    }
  );


}

</script>
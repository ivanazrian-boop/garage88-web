---
import MainLayout from "../../../layouts/MainLayout.astro";
import { supabase } from "../../../lib/supabase";

const key = Astro.url.searchParams.get("key");
const ADMIN_KEY = "garage88";

if (key !== ADMIN_KEY) {
  return Astro.redirect("/");
}

const BRANCHES = [
  "AHA Gallery",
  "AHA Nusantara",
  "AHA Gajah Mada Cipondoh",
  "AHA Gajah Mada Cipete",
  "Garage88 Kebayoran",
  "Garage88 Basura",
  "Garage88 Joglo",
  "Garage88 Ciater",
  "AHA ADEX",
];

let message = "";
let messageType: "success" | "error" = "success";


/* =====================================================
   BULK ACTION
   ===================================================== */

if (Astro.request.method === "POST") {
  const formData =
    await Astro.request.formData();

  const action =
    formData.get("action")?.toString() || "";

  const selectedIds =
    formData
      .getAll("selected_ids")
      .map((value) => value.toString())
      .filter(Boolean);

  if (selectedIds.length === 0) {
    message =
      "Belum ada unit yang dipilih.";

    messageType =
      "error";
  } else {

    /* ===============================================
       SET FEATURED
       =============================================== */

    if (action === "set_featured") {
      const { error } =
        await supabase
          .from("cars")
          .update({
            featured: true,
            updated_at:
              new Date().toISOString(),
          })
          .in(
            "id",
            selectedIds
          );

      if (error) {
        console.error(error);

        message =
          error.message;

        messageType =
          "error";
      } else {
        message =
          `${selectedIds.length} unit berhasil dijadikan Featured.`;
      }
    }


    /* ===============================================
       REMOVE FEATURED
       =============================================== */

    else if (
      action ===
      "remove_featured"
    ) {
      const { error } =
        await supabase
          .from("cars")
          .update({
            featured: false,
            updated_at:
              new Date().toISOString(),
          })
          .in(
            "id",
            selectedIds
          );

      if (error) {
        console.error(error);

        message =
          error.message;

        messageType =
          "error";
      } else {
        message =
          `${selectedIds.length} unit berhasil dihapus dari Featured.`;
      }
    }


    /* ===============================================
       DELETE SELECTED
       =============================================== */

    else if (
      action ===
      "delete_selected"
    ) {
      const { error } =
        await supabase
          .from("cars")
          .delete()
          .in(
            "id",
            selectedIds
          );

      if (error) {
        console.error(error);

        message =
          error.message;

        messageType =
          "error";
      } else {
        message =
          `${selectedIds.length} unit berhasil dihapus.`;
      }
    }
  }
}


/* =====================================================
   GET CARS
   ===================================================== */

const {
  data: cars,
  error,
} =
  await supabase
    .from("cars")
    .select(`
      id,
      brand,
      model,
      variant,
      year,
      branch,
      status,
      featured,
      ig_image_url,
      meta_image_url,
      credit_price,
      cash_price,
      created_at
    `)
    .order(
      "featured",
      {
        ascending: false,
      }
    )
    .order(
      "created_at",
      {
        ascending: false,
      }
    );

if (error) {
  console.error(error);

  message =
    error.message;

  messageType =
    "error";
}

const carList =
  cars ?? [];


/* =====================================================
   PRICE
   ===================================================== */

function formatPrice(
  value?: number | null
) {
  if (
    value === null ||
    value === undefined
  ) {
    return "-";
  }

  return new Intl.NumberFormat(
    "id-ID",
    {
      style: "currency",
      currency: "IDR",
      maximumFractionDigits: 0,
    }
  ).format(value);
}
---

<MainLayout title="Manage Stock | Garage88 Admin">

<section
  class="
    min-h-screen
    bg-slate-100
    py-10
  "
>

<div
  class="
    mx-auto
    max-w-7xl
    px-5
  "
>


  <!-- ================================================= -->
  <!-- HEADER -->
  <!-- ================================================= -->

  <div
    class="
      flex
      flex-col
      gap-4
      md:flex-row
      md:items-center
      md:justify-between
    "
  >

    <div>

      <h1
        class="
          text-3xl
          font-bold
          text-slate-900
        "
      >
        Manage Featured & Booked
      </h1>

      <p
        class="
          mt-2
          text-slate-500
        "
      >
        Bulk update Featured dan hapus unit Booked dengan cepat.
      </p>

    </div>


    <a
      href={`/admin/cars?key=${ADMIN_KEY}`}
      class="
        inline-flex
        items-center
        justify-center
        rounded-xl
        border
        border-slate-300
        bg-white
        px-5
        py-3
        font-semibold
        text-slate-700
        hover:bg-slate-50
      "
    >
      ← Kembali ke Stock
    </a>

  </div>


  <!-- ================================================= -->
  <!-- MESSAGE -->
  <!-- ================================================= -->

  {
    message && (
      <div
        class:list={[
          "mt-6 rounded-xl p-4 font-semibold",

          messageType === "success"
            ? "bg-green-100 text-green-700"
            : "bg-red-100 text-red-700",
        ]}
      >
        {message}
      </div>
    )
  }


  <!-- ================================================= -->
  <!-- FILTER -->
  <!-- ================================================= -->

  <div
    class="
      mt-8
      grid
      gap-4
      rounded-2xl
      bg-white
      p-5
      shadow-sm
      md:grid-cols-2
      lg:grid-cols-5
    "
  >


    <!-- SEARCH -->

    <div
      class="
        md:col-span-2
      "
    >

      <label
        class="
          mb-2
          block
          text-sm
          font-semibold
          text-slate-600
        "
      >
        Search Unit
      </label>

      <input
        id="searchInput"
        type="text"
        placeholder="Contoh: alphard 2021 / elgrand 2007"
        autocomplete="off"
        class="
          w-full
          rounded-xl
          border
          border-slate-300
          px-4
          py-3
          outline-none
          focus:border-blue-500
          focus:ring-2
          focus:ring-blue-100
        "
      />

      <p
        class="
          mt-1
          text-[11px]
          text-slate-400
        "
      >
        Bisa cari beberapa kata sekaligus.
      </p>

    </div>


    <!-- STATUS -->

    <div>

      <label
        class="
          mb-2
          block
          text-sm
          font-semibold
          text-slate-600
        "
      >
        Status
      </label>

      <select
        id="statusFilter"
        class="
          w-full
          rounded-xl
          border
          border-slate-300
          px-4
          py-3
        "
      >

        <option value="ALL">
          ALL STATUS
        </option>

        <option value="READY">
          READY
        </option>

        <option value="BOOKED">
          BOOKED
        </option>

        <option value="SOLD">
          SOLD
        </option>

      </select>

    </div>


    <!-- FEATURED -->

    <div>

      <label
        class="
          mb-2
          block
          text-sm
          font-semibold
          text-slate-600
        "
      >
        Featured
      </label>

      <select
        id="featuredFilter"
        class="
          w-full
          rounded-xl
          border
          border-slate-300
          px-4
          py-3
        "
      >

        <option value="ALL">
          ALL FEATURED
        </option>

        <option value="YES">
          FEATURED
        </option>

        <option value="NO">
          NOT FEATURED
        </option>

      </select>

    </div>


    <!-- CABANG -->

    <div>

      <label
        class="
          mb-2
          block
          text-sm
          font-semibold
          text-slate-600
        "
      >
        Cabang
      </label>

      <select
        id="branchFilter"
        class="
          w-full
          rounded-xl
          border
          border-slate-300
          px-4
          py-3
        "

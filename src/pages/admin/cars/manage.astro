          Remove Featured
        </button>


        <button
          type="submit"
          name="action"
          value="delete_selected"
          id="deleteSelectedButton"
          class="
            rounded-xl
            bg-red-600
            px-4
            py-2.5
            font-bold
            text-white
            hover:bg-red-700
          "

    </div>

  </div>


  <!-- ================================================= -->
  <!-- BULK FORM -->
  <!-- ================================================= -->

  <form
    method="POST"
    id="bulkForm"
    class="
      mt-6
      rounded-2xl
      bg-white
      shadow-sm
    "
  >


    <!-- ================================================= -->
    <!-- ACTION BAR -->
    <!-- ================================================= -->

    <div
      class="

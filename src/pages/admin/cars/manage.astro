          🗑 Delete Selected
        </button>

      </div>

    </div>


    <!-- ================================================= -->
    <!-- TABLE -->
    <!-- ================================================= -->

    <div class="overflow-x-auto">

      <table
        class="
          w-full
          min-w-[1050px]
        "
      >

        <thead
          class="
            bg-slate-50
          "
        >

          <tr
            class="
              text-left
              text-sm
              uppercase
              tracking-wide
              text-slate-500
            "
          >

            <th
              class="
                w-14
                px-4
                py-4
              "
            >
              ✓
            </th>

            <th
              class="
                px-4
                py-4
              "
            >
              Unit
            </th>

            <th
              class="
                px-4
                py-4
              "
            >
              Cabang
            </th>

            <th
              class="
                px-4
                py-4
              "
            >
              Status
            </th>

            <th
              class="
                px-4
                py-4
              "
            >
              Featured
            </th>

            <th
              class="
                px-4
                py-4
              "
            >
              Harga
            </th>

            <th
              class="
                px-4
                py-4
              "
            >
              Action
            </th>

          </tr>

        </thead>


        <tbody>

          {
            carList.map((car) => {

              /*
               * Search text dibuat panjang supaya
               * pencarian beberapa kata lebih mudah.
               */

              const searchText = [
                car.brand,
                car.model,
                car.variant,
                car.year,
                car.branch,
                car.status,
              ]
                .filter(Boolean)
                .join(" ")
                .toLowerCase();

              const branchValue =
                car.branch?.trim()
                  ? car.branch
                  : "__UNASSIGNED__";

              return (

                <tr
                  class="
                    car-row
                    border-t
                    border-slate-100
                    hover:bg-slate-50
                  "
                  data-search={searchText}
                  data-status={car.status ?? ""}
                  data-featured={
                    car.featured
                      ? "YES"

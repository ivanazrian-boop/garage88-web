        flex-col
        gap-3
        border-b
        border-slate-200
        bg-white
        p-4
        md:flex-row
        md:items-center
        md:justify-between
      "
    >

      <div
        class="
          flex
          flex-wrap
          items-center
          gap-3
        "
      >

        <label

                  data-branch={branchValue}
                >


                  <!-- CHECK -->

                  <td
                    class="
                      px-4
                      py-4
                    "
                  >

                    <input
                      type="checkbox"
                      name="selected_ids"
                      value={car.id}
                      class="
                        car-checkbox
                        h-5
                        w-5
                      "
                    />

                  </td>


                  <!-- UNIT -->

                  <td
                    class="
                      px-4
                      py-4
                    "
                  >

                    <div
                      class="
                        flex
                        items-center
                        gap-4
                      "
                    >

                      {
                        car.ig_image_url
                          ? (
                            <img
                              src={car.ig_image_url}
                              alt=""
                              class="
                                h-20
                                w-16
                                rounded-lg
                                border
                                object-cover
                              "
                            />
                          )
                          : (
                            <div
                              class="
                                flex
                                h-20
                                w-16
                                items-center
                                justify-center
                                rounded-lg
                                bg-slate-200
                                text-xs
                                text-slate-500
                              "
                            >
                              No IMG
                            </div>
                          )
                      }


                      <div>

                        <div
                          class="
                            font-bold
                            text-slate-900
                          "
                        >
                          {car.brand} {car.model}
                        </div>


                        <div
                          class="
                            mt-1
                            text-sm
                            text-slate-500
                          "
                        >
                          {car.variant ?? "-"} {car.year ?? ""}
                        </div>

                      </div>

                    </div>

                  </td>


                  <!-- CABANG -->

                  <td
                    class="
                      px-4
                      py-4
                      text-sm
                      text-slate-600
                    "
                  >

                    {
                      car.branch?.trim()
                        ? car.branch
                        : (
                          <span
                            class="
                              font-semibold
                              text-red-500
                            "
                          >
                            BELUM ADA CABANG
                          </span>
                        )
                    }

                  </td>


                  <!-- STATUS -->

                  <td
                    class="
                      px-4
                      py-4
                    "
                  >

                    <span
                      class:list={[
                        "inline-flex rounded-full px-3 py-1 text-xs font-bold",

                        car.status === "READY"
                          ? "bg-green-100 text-green-700"

                          : car.status === "BOOKED"
                            ? "bg-orange-100 text-orange-700"

                            : "bg-slate-200 text-slate-700",
                      ]}
                    >
                      {car.status ?? "-"}
                    </span>

                  </td>


                  <!-- FEATURED -->

                  <td
                    class="
                      px-4
                      py-4
                    "
                  >

                    {
                      car.featured
                        ? (
                          <span
                            class="
                              inline-flex
                              rounded-full
                              bg-amber-100
                              px-3
                              py-1
                              text-xs
                              font-bold
                              text-amber-700
                            "
                          >
                            ⭐ FEATURED
                          </span>
                        )
                        : (
                          <span
                            class="
                              text-sm
                              text-slate-400
                            "
                          >
                            -
                          </span>
                        )
                    }

                  </td>


                  <!-- PRICE -->

                  <td
                    class="
                      px-4
                      py-4
                      text-sm
                      text-slate-700
                    "
                  >

                    <div>
                      Kredit:
                      <strong>
                        {formatPrice(car.credit_price)}
                      </strong>
                    </div>

                    <div
                      class="
                        mt-1
                      "
                    >
                      Cash:
                      <strong>
                        {formatPrice(car.cash_price)}
                      </strong>
                    </div>

                  </td>


                  <!-- ACTION -->

                  <td
                    class="
                      px-4
                      py-4
                    "
                  >

                    <a
                      href={`/admin/cars/edit?id=${car.id}&key=${ADMIN_KEY}`}
                      class="
                        rounded-lg
                        bg-blue-600
                        px-3
                        py-2
                        text-sm
                        font-semibold
                        text-white
                        hover:bg-blue-700
                      "
                    >
                      Edit
                    </a>

                  </td>

                </tr>

              );

            })
          }

        </tbody>

      </table>

    </div>


    <!-- EMPTY -->

    <div
      id="emptyState"
      class="
        hidden
        p-10
        text-center
        text-slate-500
      "
    >
      Tidak ada unit sesuai filter.
    </div>

  </form>

</div>

</section>


<script is:inline>

  /* =====================================================
     NORMALIZE SEARCH
     ===================================================== */

  function normalizeSearch(value) {
    return String(value || "")
      .toLowerCase()
      .replace(
        /[^a-z0-9]+/g,
        " "
      )
      .replace(
        /\s+/g,
        " "
      )
      .trim();
  }


  /* =====================================================
     ELEMENTS
     ===================================================== */

  const searchInput =
    document.getElementById(
      "searchInput"
    );

  const statusFilter =
    document.getElementById(
      "statusFilter"
    );

  const featuredFilter =
    document.getElementById(
      "featuredFilter"
    );

  const branchFilter =
    document.getElementById(
      "branchFilter"
    );

  const clearFilterButton =
    document.getElementById(
      "clearFilterButton"
    );

  const selectAll =
    document.getElementById(
      "selectAll"
    );

  const selectedCount =
    document.getElementById(
      "selectedCount"
    );

  const visibleCount =
    document.getElementById(
      "visibleCount"
    );

  const deleteSelectedButton =
    document.getElementById(
      "deleteSelectedButton"
    );

  const bulkForm =
    document.getElementById(
      "bulkForm"
    );

  const emptyState =
    document.getElementById(
      "emptyState"
    );


  /* =====================================================
     ROW HELPERS
     ===================================================== */

  function getRows() {
    return Array.from(
      document.querySelectorAll(
        ".car-row"
      )
    );
  }


  function getCheckboxes() {
    return Array.from(
      document.querySelectorAll(
        ".car-checkbox"
      )
    );
  }


  /* =====================================================
     FILTER
     ===================================================== */

  function applyFilters() {

    const rawSearch =
      normalizeSearch(
        searchInput?.value || ""
      );


    /*
     * TELEGRAM STYLE SEARCH
     *
     * "alphard 2021"
     *
     * menjadi:
     *
     * ["alphard", "2021"]
     *
     * Semua kata harus ada pada row,
     * tapi tidak harus berdempetan.
     */

    const searchTokens =
      rawSearch
        .split(" ")
        .filter(Boolean);


    const status =
      String(
        statusFilter?.value ||
        "ALL"
      );


    const featured =
      String(
        featuredFilter?.value ||
        "ALL"
      );


    const branch =
      String(
        branchFilter?.value ||
        "ALL"
      );


    let currentVisibleCount =
      0;


    getRows().forEach(
      (row) => {

        const searchText =
          normalizeSearch(
            row.dataset.search ||
            ""
          );


        const rowStatus =
          String(
            row.dataset.status ||
            ""
          );


        const rowFeatured =
          String(
            row.dataset.featured ||
            "NO"
          );


        const rowBranch =
          String(
            row.dataset.branch ||
            "__UNASSIGNED__"
          );


        /*
         * Semua keyword harus ditemukan.
         */

        const matchSearch =
          searchTokens.length === 0 ||
          searchTokens.every(
            (token) =>
              searchText.includes(
                token
              )
          );


        const matchStatus =
          status === "ALL" ||
          rowStatus === status;


        const matchFeatured =
          featured === "ALL" ||
          rowFeatured === featured;


        const matchBranch =
          branch === "ALL" ||
          rowBranch === branch;


        const visible =
          matchSearch &&
          matchStatus &&
          matchFeatured &&
          matchBranch;


        row.style.display =
          visible
            ? ""
            : "none";


        if (visible) {
          currentVisibleCount++;
        }

      }
    );


    if (visibleCount) {
      visibleCount.textContent =
        `${currentVisibleCount} visible`;
    }


    if (emptyState) {
      emptyState.classList.toggle(
        "hidden",
        currentVisibleCount > 0
      );
    }


    if (selectAll) {
      selectAll.checked =
        false;
    }


    updateSelectedCount();

  }


  /* =====================================================
     SELECTED COUNT
     ===================================================== */

  function updateSelectedCount() {

    const checked =
      getCheckboxes()
        .filter(
          (checkbox) =>
            checkbox.checked
        )
        .length;


    if (selectedCount) {
      selectedCount.textContent =
        `${checked} selected`;
    }

  }


  /* =====================================================
     FILTER EVENTS
     ===================================================== */

  searchInput?.addEventListener(
    "input",
    applyFilters
  );


  statusFilter?.addEventListener(
    "change",
    applyFilters
  );


  featuredFilter?.addEventListener(
    "change",
    applyFilters
  );


  branchFilter?.addEventListener(
    "change",
    applyFilters
  );


  /* =====================================================
     RESET
     ===================================================== */

  clearFilterButton?.addEventListener(
    "click",
    () => {

      searchInput.value =
        "";

      statusFilter.value =
        "ALL";

      featuredFilter.value =
        "ALL";

      branchFilter.value =
        "ALL";


      applyFilters();

    }
  );


  /* =====================================================
     SELECT ALL VISIBLE
     ===================================================== */

  selectAll?.addEventListener(
    "change",
    () => {

      const checked =
        selectAll.checked;


      getRows().forEach(
        (row) => {

          if (
            row.style.display ===
            "none"
          ) {
            return;
          }


          const checkbox =
            row.querySelector(
              ".car-checkbox"
            );


          if (checkbox) {
            checkbox.checked =
              checked;
          }

        }
      );


      updateSelectedCount();

    }
  );


  /* =====================================================
     CHECKBOX
     ===================================================== */

  getCheckboxes().forEach(
    (checkbox) => {

      checkbox.addEventListener(
        "change",
        updateSelectedCount
      );

    }
  );


  /* =====================================================
     DELETE CONFIRMATION
     ===================================================== */

  deleteSelectedButton?.addEventListener(
    "click",
    (event) => {

      const selected =
        getCheckboxes()
          .filter(
            (checkbox) =>
              checkbox.checked
          );


      if (
        selected.length === 0
      ) {

        event.preventDefault();


        alert(
          "Pilih unit yang mau dihapus dulu."
        );


        return;

      }


      const confirmed =
        confirm(
          `Hapus permanen ${selected.length} unit?\n\nTindakan ini tidak bisa dibatalkan.`
        );


      if (!confirmed) {
        event.preventDefault();
      }

    }
  );


  /* =====================================================
     OTHER BULK ACTION VALIDATION
     ===================================================== */

  bulkForm?.addEventListener(
    "submit",
    (event) => {

      const submitter =
        event.submitter;


      if (
        submitter &&
        submitter.value ===
          "delete_selected"
      ) {
        return;
      }


      const selected =
        getCheckboxes()
          .filter(
            (checkbox) =>
              checkbox.checked
          );


      if (
        selected.length === 0
      ) {

        event.preventDefault();


        alert(
          "Pilih minimal satu unit dulu."
        );

      }

    }
  );


  /* =====================================================
     INITIAL FILTER
     ===================================================== */

  applyFilters();

</script>

</MainLayout>
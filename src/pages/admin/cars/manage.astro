            rounded-xl
            bg-amber-400
            px-4
            py-2.5
            font-bold
            text-slate-900
            hover:bg-amber-500
          "
        >
          ⭐ Set Featured
        </button>


        <button
          type="submit"
          name="action"
          value="remove_featured"
          class="
            rounded-xl
            bg-slate-700
            px-4
            py-2.5
            font-bold
            text-white

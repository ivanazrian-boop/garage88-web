---
import MainLayout from "../../layouts/MainLayout.astro";
import CarGallery from "../../components/cars/CarGallery.astro";

import {
  getCars,
  getCarBySlug,
} from "../../services/cars.service";

import type { CarImage } from "../../types/car-image";

import { supabase } from "../../lib/supabase";


export async function getStaticPaths() {

  const cars = await getCars();

  return cars.map((car)=>({

    params:{
      slug:car.slug
    }

  }));

}


const {slug}=Astro.params;


if(!slug){

  return Astro.redirect("/stock");

}



const car = await getCarBySlug(slug);



if(!car){

  return Astro.redirect("/stock");

}



const {data:images}=await supabase
.from("car_images")
.select("*")
.eq("car_id",car.id)
.order("sort_order",{ascending:true});



const carImages:CarImage[]=images ?? [];



const allCars=await getCars();



const similarCars =
allCars
.filter(
(item)=>
item.id!==car.id &&
item.brand===car.brand
)
.slice(0,4);



const formatPrice=(value:number|null)=>{

if(!value) return "-";

return new Intl.NumberFormat(
"id-ID",
{
style:"currency",
currency:"IDR",
maximumFractionDigits:0
}
).format(value);

};



const formatNumber=(value:number|null)=>{

if(!value) return "-";

return new Intl.NumberFormat("id-ID")
.format(value);

};



const whatsappMessage =
encodeURIComponent(

`Halo Garage88,

Saya tertarik dengan unit berikut.

${car.brand} ${car.model}${car.variant ? ` ${car.variant}` : ""}
Tahun : ${car.year}

Mohon info ketersediaan unitnya.

Terima kasih.`

);



const whatsappUrl =
`https://wa.me/6281385226049?text=${whatsappMessage}`;



const pageTitle =
`${car.brand} ${car.model}${car.variant ? ` ${car.variant}` : ""} ${car.year} | Garage88`;



const pageDescription =
car.description ??
`${car.brand} ${car.model} ${car.year} bekas berkualitas di Garage88.`;
const metaContentName =
`${car.brand} ${car.model} ${car.year}`;
---

<MainLayout title={pageTitle}>


<section class="mx-auto max-w-7xl px-4 py-6 md:py-10">


<div class="mb-6 md:mb-8">


<a
href="/stock"
class="text-sm text-blue-600 hover:underline"
>
← Kembali ke Stock
</a>



<h1 class="mt-4 text-2xl font-bold md:text-3xl">

{car.brand}
{" "}
{car.model}
{" "}
{car.variant}

</h1>



<p class="mt-2 text-slate-500">

Tahun {car.year}

</p>


</div>





<div class="grid gap-8 lg:grid-cols-2 lg:gap-10">


<div>

<CarGallery
images={carImages}
/>

</div>





<div class="space-y-6">


<div class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm md:p-6">


<div class="flex items-start justify-between">


<div>

<h2 class="text-2xl font-bold">

{formatPrice(car.credit_price)}

</h2>


<p class="mt-1 text-slate-500">

Harga Kredit

</p>


</div>



<span
class:list={[
"rounded-full px-4 py-2 text-sm font-semibold",
car.status === "BOOKED"
? "bg-red-100 text-red-700"
: "bg-green-100 text-green-700"
]}
>

{car.status}

</span>


</div>

<div class="mt-6 space-y-4">


<div class="flex justify-between border-b pb-3">

<span class="text-slate-500">
Harga Cash
</span>

<span class="font-semibold">
{formatPrice(car.cash_price)}
</span>

</div>



<div class="flex justify-between border-b pb-3">

<span class="text-slate-500">
DP Mulai
</span>

<span class="font-semibold">
{formatPrice(car.dp)}
</span>

</div>



<div class="flex justify-between border-b pb-3">

<span class="text-slate-500">
Odometer
</span>

<span class="font-semibold">
{formatNumber(car.odometer)} KM
</span>

</div>



<div class="flex justify-between border-b pb-3">

<span class="text-slate-500">
Transmisi
</span>

<span class="font-semibold">
{car.transmission ?? "-"}
</span>

</div>



<div class="flex justify-between border-b pb-3">

<span class="text-slate-500">
Bahan Bakar
</span>

<span class="font-semibold">
{car.fuel ?? "-"}
</span>

</div>



<div class="flex justify-between border-b pb-3">

<span class="text-slate-500">
Warna
</span>

<span class="font-semibold">
{car.color ?? "-"}
</span>

</div>


</div>



<a
href={whatsappUrl}
target="_blank"
rel="noopener noreferrer"
onclick="window.trackWhatsApp && window.trackWhatsApp()"
class="
mt-8
flex
w-full
items-center
justify-center
rounded-xl
bg-green-600
px-6
py-4
text-lg
font-semibold
text-white
transition
hover:bg-green-700
"
>
Chat via WhatsApp
</a>



</div>

</div>

</div>





<!-- SPESIFIKASI -->

<div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 md:p-8">


<h2 class="mb-6 text-2xl font-bold">
Spesifikasi Kendaraan
</h2>



<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">



{
[
["Merk",car.brand],
["Model",car.model],
["Varian",car.variant],
["Tahun",car.year],
["Transmisi",car.transmission],
["Bahan Bakar",car.fuel],
["Warna",car.color],
["Odometer",`${formatNumber(car.odometer)} KM`],
["Status",car.status]
].map(item => (

<div class="rounded-xl border p-5">

<p class="text-sm text-slate-500">
{item[0]}
</p>


<p class="mt-2 font-semibold">
{item[1] ?? "-"}
</p>


</div>

))
}


</div>


</div>






<!-- DESKRIPSI -->

<div class="mt-10 rounded-2xl border border-slate-200 bg-white p-6 md:p-8">


<h2 class="mb-5 text-2xl font-bold">
Deskripsi
</h2>



{
car.description ? (

<p class="whitespace-pre-line leading-8 text-slate-600">
{car.description}
</p>

) : (

<p class="text-slate-500">
Belum ada deskripsi untuk kendaraan ini.
</p>

)

}



</div>







<!-- MOBIL SERUPA -->


<div class="mt-10">


<h2 class="mb-6 text-2xl font-bold">
Mobil Serupa
</h2>




{
similarCars.length > 0 ? (


<div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4">


{
similarCars.map((item)=>(


<a
href={`/detail/${item.slug}`}
class="
overflow-hidden
rounded-2xl
border
border-slate-200
bg-white
shadow-sm
transition
hover:-translate-y-1
hover:shadow-lg
"
>


<div class="aspect-[4/3] bg-slate-100">


<img

src={`https://placehold.co/600x450?text=${encodeURIComponent(
`${item.brand} ${item.model}`
)}`}

alt={`${item.brand} ${item.model}`}

class="
h-full
w-full
object-contain
"

/>


</div>




<div class="p-5">


<h3 class="line-clamp-2 text-lg font-bold">

{item.brand}

{" "}

{item.model}

{" "}

{item.variant}

</h3>




<p class="mt-2 text-sm text-slate-500">

Tahun {item.year}

</p>




<p class="mt-4 text-xl font-bold text-blue-600">

{formatPrice(item.credit_price)}

</p>




<p class="mt-1 text-sm text-slate-500">

Harga Kredit

</p>



<div class="mt-5">

<span
class="rounded-lg bg-slate-100 px-3 py-2 text-sm font-medium"
>

{formatNumber(item.odometer)} KM

</span>


</div>


</div>



</a>


))

}


</div>


) : (


<div class="rounded-xl border border-dashed border-slate-300 bg-white p-8 text-center text-slate-500">

Belum ada mobil serupa.

</div>


)

}


</div>





<!-- CTA -->

<section
class="
mt-16
rounded-2xl
bg-slate-900
px-6
py-10
text-center
text-white
md:px-8
md:py-12
">


<h2 class="text-2xl font-bold md:text-3xl">

Masih punya pertanyaan?

</h2>


<p class="mx-auto mt-4 max-w-2xl text-slate-300">

Hubungi tim Garage88 sekarang juga.
Kami siap membantu simulasi kredit,
trade in, maupun pembelian secara cash.

</p>



<a
href={whatsappUrl}
target="_blank"
rel="noopener noreferrer"
onclick="window.trackWhatsApp && window.trackWhatsApp()"
class="
mt-8
inline-flex
rounded-xl
bg-green-500
px-8
py-4
font-semibold
text-white
transition
hover:bg-green-600
"
>

Chat WhatsApp

</a>


</section>



</section>




<!-- FLOATING WHATSAPP MOBILE -->

<a
href={whatsappUrl}
target="_blank"
rel="noopener noreferrer"
class="
fixed
bottom-5
left-5
right-5
z-50
rounded-xl
bg-green-600
px-6
py-4
text-center
font-bold
text-white
shadow-lg
md:hidden
"
>

Chat WhatsApp

</a>





<style>

:global(body){

background:#f8fafc;

}


.line-clamp-2{

display:-webkit-box;

-webkit-line-clamp:2;

-webkit-box-orient:vertical;

overflow:hidden;

}

</style>

<script is:inline define:vars={{
  metaContentName,
  carId: car.id,
  creditPrice: car.credit_price ?? 0
}}>

fbq('track', 'ViewContent', {

  content_name: metaContentName,

  content_category: "Mobil Bekas",

  content_ids: [
    carId
  ],

  value: creditPrice,

  currency: "IDR"

});

</script>

</MainLayout>
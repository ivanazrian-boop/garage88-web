{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garage88-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-15",

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },

  "images": {
    "binding": "IMAGES"
  },

  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "a716cc54073945578d0cca6ab8509898"
    }
  ],

  "browser": {
  "binding": "BROWSER",
  "remote": true
  }
}

{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "garage88-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "images": {
    "binding": "IMAGES"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "a716cc54073945578d0cca6ab8509898"
    }
  ],
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "garage88-cars",
      "remote": true
    }
  ],
  "vars": {
    "R2_PUBLIC_URL": "https://img.garage88.site"
  }
}
